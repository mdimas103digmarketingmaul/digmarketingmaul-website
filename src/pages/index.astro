              <div class="cert-body"><img src="/assets/images/certifications/google-ads-search-2026.png" alt="Google Ads Search Certification 2026" loading="lazy" decoding="async"></div>
            </details>
          </li>
          <li data-reveal>
            <details class="cert" data-preview="./assets/images/certifications/google-analytics-for-beginners.png">
              <summary class="cert-row"><span class="cert-index">03</span><span class="cert-name">Google Analytics for Beginners</span><span class="cert-year">2021</span><span class="cert-toggle" aria-hidden="true"></span></summary>
              <div class="cert-body"><img src="/assets/images/certifications/google-analytics-for-beginners.png" alt="Google Analytics for Beginners certificate" loading="lazy" decoding="async"></div>
            </details>
          </li>
          <li data-reveal>
            <details class="cert" data-preview="./assets/images/certifications/fundamentals-digital-marketing.png">
              <summary class="cert-row"><span class="cert-index">04</span><span class="cert-name">The Fundamentals of Digital Marketing</span><span class="cert-year">2021</span><span class="cert-toggle" aria-hidden="true"></span></summary>
