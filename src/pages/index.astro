          <li data-reveal>
            <details class="cert" data-preview="./assets/images/certifications/meta-blueprint-media-buying.png">
              <summary class="cert-row"><span class="cert-index">01</span><span class="cert-name">Meta Blueprint Badges obtained as part of the process<br class="cert-break"> “Certified Media Buying Professional”</span><span class="cert-year">2026</span><span class="cert-toggle" aria-hidden="true"></span></summary>
