---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import initScript from '../../../scripts/products/product-page-init.js?raw';
import baseCss from '../../../styles/products/website-development.css?url';
import pageCss from '../../../styles/products/graphic-design.css?url';
import pageJs from '../../../scripts/products/graphic-design.js?url';
const meta = {
  "title": "Graphic Design — Maul Digital",
  "themeColor": "#fafbfc",
  "description": "Graphic Design oleh Maul — desain untuk konten digital, materi marketing, presentasi, print, dan merchandise.",
  "canonical": "/products/graphic-design/"
};
---
<!--
  Graphic Design product page — “Hanging Samples” (light only).
  Built on the Website Development page: its stylesheet is loaded first as the shared base
  (tokens, header, hanging rail, bento, steps, pricing, payment, FAQ, brief form, footer);
  src/styles/products/graphic-design.css only adds the design-specific parts.
  Every visual on this page is an HTML/CSS sample application, not client work. No images.
  Script: src/scripts/products/graphic-design.js · notes: docs/graphic-design.md
-->
<BaseLayout meta={meta} lang="id" htmlAttributes={{"data-language": "id", "data-international": "false"}} bodyAttributes={{"data-page": "graphic-design"}}>
<Fragment slot="head">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
<link rel="stylesheet" href={baseCss} />
<link rel="stylesheet" href={pageCss} />
<script is:inline set:html={initScript}></script>
</Fragment>
  <a class="skip-link" href="#main"><span class="lang-id">Langsung ke konten</span><span class="lang-en">Skip to content</span></a>
  <div class="grain" aria-hidden="true"></div>
  <div class="cursor" aria-hidden="true">
    <span class="cursor-ring"><span class="cursor-label"></span></span>
    <span class="cursor-dot"></span>
  </div>

  <!-- ============ HEADER — same as Website Development ============ -->
  <header class="site-header" data-header>
    <div class="site-header-inner">
      <a href="/index.html#home" class="brand-logo" aria-label="M. Dimas Maulana Home"><img src="/assets/brand/logo/icon.svg" alt="digmarketingmaul" width="34" height="34"><span class="brand-word">digmarketingmaul</span></a>
      <div class="header-tools">
        <label class="lang-select">
          <span class="visually-hidden">Language</span>
          <select data-maul-language-select>
            <option value="id">ID</option>
            <option value="en">EN</option>
          </select>
        </label>
        <button class="intl-toggle" type="button" data-product-international-toggle aria-pressed="false" aria-label="International mode">
          <span class="intl-track" aria-hidden="true"><i></i></span><span>International</span>
        </button>
        <a class="btn btn-ink btn-sm header-cta" href="#contact" data-magnetic>Let's discuss</a>
      </div>
    </div>
    <div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
  </header>

  <main id="main">

    <!-- ============ HERO — headline beside the sample applications (hanging sheets) ============ -->
    <section class="hero hero--design" id="samples" aria-labelledby="design-title">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <h1 class="hero-title" id="design-title" data-reveal-title>
            <span class="mask-line"><span>Graphic</span></span>
            <span class="mask-line"><span><em>design</em><span class="accent-dot">.</span></span></span>
          </h1>
          <p class="hero-lead reveal">Design for digital content, marketing materials, presentations, print, and more.</p>
          <div class="hero-work-ui reveal">
            <p class="hero-work-label"><span class="lang-id">Bisa dibuat</span><span class="lang-en">What we make</span><span class="accent-dot">.</span> <small><span class="lang-id">Klik untuk lihat sample</span><span class="lang-en">Click to see a sample</span></small></p>
            <!-- Each button jumps the rail to the first sheet with the same data-cat -->
            <ol class="cats" aria-label="Graphic design categories">
              <li><button class="cat" type="button" data-cat-go="social"><span class="cat-num">01</span><span class="cat-name">Social media</span><span class="cat-items"><span class="lang-id">Post, story, banner, visual produk</span><span class="lang-en">Posts, stories, banners, product visuals</span></span><span class="cat-go" aria-hidden="true">→</span></button></li>
              <li><button class="cat" type="button" data-cat-go="sales"><span class="cat-num">02</span><span class="cat-name"><span class="lang-id">Promosi &amp; penjualan</span><span class="lang-en">Marketing &amp; sales</span></span><span class="cat-items"><span class="lang-id">Poster, flyer, price list, katalog, menu</span><span class="lang-en">Posters, flyers, price lists, catalogues, menus</span></span><span class="cat-go" aria-hidden="true">→</span></button></li>
              <li><button class="cat" type="button" data-cat-go="docs"><span class="cat-num">03</span><span class="cat-name"><span class="lang-id">Presentasi &amp; dokumen</span><span class="lang-en">Presentations &amp; documents</span></span><span class="cat-items"><span class="lang-id">Company profile, deck, proposal, booklet</span><span class="lang-en">Company profiles, decks, proposals, booklets</span></span><span class="cat-go" aria-hidden="true">→</span></button></li>
              <li><button class="cat" type="button" data-cat-go="print"><span class="cat-num">04</span><span class="cat-name"><span class="lang-id">Cetak &amp; event</span><span class="lang-en">Print &amp; events</span></span><span class="cat-items"><span class="lang-id">Undangan, backdrop, banner, booth, flyer cetak</span><span class="lang-en">Invitations, backdrops, banners, booths, printed flyers</span></span><span class="cat-go" aria-hidden="true">→</span></button></li>
              <li><button class="cat" type="button" data-cat-go="apparel"><span class="cat-num">05</span><span class="cat-name"><span class="lang-id">Kaos &amp; jersey</span><span class="lang-en">T-shirts &amp; jerseys</span></span><span class="cat-items"><span class="lang-id">Kaos, jersey olahraga, merchandise</span><span class="lang-en">T-shirts, sports jerseys, merchandise</span></span><span class="cat-go" aria-hidden="true">→</span></button></li>
              <li><button class="cat" type="button" data-cat-go="logo"><span class="cat-num">06</span><span class="cat-name">Simple logo</span><span class="cat-items"><span class="lang-id">Logo sederhana untuk UMKM</span><span class="lang-en">A simple logo for small businesses</span></span><span class="cat-go" aria-hidden="true">→</span></button></li>
            </ol>
            <div class="hang-ui">
              <p class="hang-label">Sample applications</p>
              <p class="hang-count"><b data-hang-current>01</b> / <span data-hang-total>08</span></p>
              <button class="round-btn" type="button" data-hang-prev aria-label="Previous sample"><span aria-hidden="true">←</span></button>
              <button class="round-btn" type="button" data-hang-next aria-label="Next sample"><span aria-hidden="true">→</span></button>
            </div>
          </div>
        </div>

        <div class="hero-work">
        <div class="hang hang--design" data-hang>
          <span class="hang-rail" aria-hidden="true"></span>
          <div class="hang-viewport" data-hang-viewport tabindex="0" role="region" aria-roledescription="carousel" aria-label="Sample applications — drag, or use the arrow keys">
            <ol class="hang-track" data-hang-track>
              <!--
                Each sheet is a sample made in HTML/CSS (.art-*, styled in graphic-design.css).
                Real client work can replace these one by one: swap the .sheet-screen content for an
                <img> (WebP, ~1200px wide, width/height set, loading="lazy" after the first two)
                and the caption's "Sample" tag for the client's name.
              -->

              <!-- 01 Social post · 4:5 -->
              <li class="sheet" data-cat="social" style="--tone:#f3e7d3">
                <div class="sheet-swing">
                  <span class="sheet-string" aria-hidden="true"></span><span class="sheet-clip" aria-hidden="true"></span>
                  <div class="sheet-paper" data-cursor="Drag">
                    <div class="sheet-screen art art-post" role="img" aria-label="Sample social media post for a coffee shop: Es Kopi Aren, new on the menu">
                      <span class="ap-brand"><i></i>teduh</span>
                      <span class="ap-badge">Baru</span>
                      <span class="ap-title">Es Kopi<br>Aren<span>.</span></span>
                      <span class="ap-sun"></span>
                      <span class="ap-glass"><i></i></span>
                      <span class="ap-price">Rp18K</span>
                      <span class="ap-dots"><i></i><i></i><i></i></span>
                    </div>
                    <span class="sheet-caption">
                      <span class="sheet-idx">01</span>
                      <span class="sheet-name"><strong>Social post</strong><small>Social media</small></span>
                      <span class="sheet-tag">Sample</span>
                    </span>
                  </div>
                </div>
              </li>

              <!-- 02 Sales poster · A-series -->
              <li class="sheet" data-cat="sales" style="--tone:#0d0d0d">
                <div class="sheet-swing">
                  <span class="sheet-string" aria-hidden="true"></span><span class="sheet-clip" aria-hidden="true"></span>
                  <div class="sheet-paper" data-cursor="Drag">
                    <div class="sheet-screen art art-poster" role="img" aria-label="Sample sales poster for a running store: Mega Sale, up to 50% off">
                      <span class="as-brand">LARI.CO</span>
                      <span class="as-kicker">Mega sale</span>
                      <span class="as-big">50<small>%</small></span>
                      <span class="as-band"><span>Up to 50% off · Up to 50% off · Up to 50% off · Up to 50% off ·</span></span>
                      <span class="as-foot"><span>Weekend only</span><span>All stores</span></span>
                    </div>
                    <span class="sheet-caption">
                      <span class="sheet-idx">02</span>
                      <span class="sheet-name"><strong>Sales poster</strong><small><span class="lang-id">Promosi &amp; penjualan</span><span class="lang-en">Marketing &amp; sales</span></small></span>
                      <span class="sheet-tag">Sample</span>
                    </span>
                  </div>
                </div>
              </li>

              <!-- 03 Menu · A-series -->
              <li class="sheet" data-cat="sales" style="--tone:#1f3b2d">
                <div class="sheet-swing">
                  <span class="sheet-string" aria-hidden="true"></span><span class="sheet-clip" aria-hidden="true"></span>
                  <div class="sheet-paper" data-cursor="Drag">
                    <div class="sheet-screen art art-menu" role="img" aria-label="Sample restaurant menu with food and drink prices">
                      <span class="am-leaf"></span>
                      <span class="am-brand">Dapur Rimbun</span>
                      <span class="am-title">Menu</span>
                      <span class="am-group">Makan</span>
                      <span class="am-row"><span>Nasi Goreng Rimbun</span><i></i><b>32</b></span>
                      <span class="am-row"><span>Mie Kuah Kampung</span><i></i><b>28</b></span>
                      <span class="am-row"><span>Sate Ayam</span><i></i><b>35</b></span>
                      <span class="am-group">Minum</span>
                      <span class="am-row"><span>Es Teh Serai</span><i></i><b>12</b></span>
                      <span class="am-row"><span>Kopi Susu</span><i></i><b>18</b></span>
                      <span class="am-foot"><span>Buka setiap hari</span><span>10.00–22.00</span></span>
                    </div>
                    <span class="sheet-caption">
                      <span class="sheet-idx">03</span>
                      <span class="sheet-name"><strong>Menu</strong><small><span class="lang-id">Promosi &amp; penjualan</span><span class="lang-en">Marketing &amp; sales</span></small></span>
                      <span class="sheet-tag">Sample</span>
                    </span>
                  </div>
                </div>
              </li>

              <!-- 04 Company profile slide · 16:9 -->
              <li class="sheet" data-cat="docs" style="--tone:#ffffff">
                <div class="sheet-swing">
                  <span class="sheet-string" aria-hidden="true"></span><span class="sheet-clip" aria-hidden="true"></span>
                  <div class="sheet-paper" data-cursor="Drag">
                    <div class="sheet-screen art art-deck" role="img" aria-label="Sample company profile slide for a logistics company: About us">
                      <span class="ad-copy">
                        <span class="ad-label">Company profile</span>
                        <span class="ad-title">About<br>us<span>.</span></span>
                        <span class="ad-lines"><i></i><i></i><i></i></span>
                      </span>
                      <span class="ad-visual"><i></i><i></i><i></i><i></i></span>
                      <span class="ad-foot"><span>Nusa Logistik</span><span>03 / 12</span></span>
                    </div>
                    <span class="sheet-caption">
                      <span class="sheet-idx">04</span>
                      <span class="sheet-name"><strong>Company profile</strong><small><span class="lang-id">Presentasi &amp; dokumen</span><span class="lang-en">Presentations &amp; documents</span></small></span>
                      <span class="sheet-tag">Sample</span>
                    </span>
                  </div>
                </div>
              </li>

              <!-- 05 Wedding invitation · 5:7 -->
              <li class="sheet" data-cat="print" style="--tone:#f7f1e8">
                <div class="sheet-swing">
                  <span class="sheet-string" aria-hidden="true"></span><span class="sheet-clip" aria-hidden="true"></span>
                  <div class="sheet-paper" data-cursor="Drag">
                    <div class="sheet-screen art art-invite" role="img" aria-label="Sample wedding invitation: The wedding of Rani and Bima">
                      <span class="ai-arch">
                        <span class="ai-kicker">The wedding of</span>
                        <span class="ai-names">Rani<br><span>&amp;</span> Bima</span>
                        <span class="ai-rule"></span>
                        <span class="ai-date">12 · 12 · 2026</span>
                      </span>
                      <span class="ai-foot">Save the date</span>
                    </div>
                    <span class="sheet-caption">
                      <span class="sheet-idx">05</span>
                      <span class="sheet-name"><strong><span class="lang-id">Undangan</span><span class="lang-en">Invitation</span></strong><small><span class="lang-id">Cetak &amp; event</span><span class="lang-en">Print &amp; events</span></small></span>
                      <span class="sheet-tag">Sample</span>
                    </span>
                  </div>
                </div>
              </li>

              <!-- 06 Sports jersey · 1:1 -->
              <li class="sheet" data-cat="apparel" style="--tone:#e9edf2">
                <div class="sheet-swing">
                  <span class="sheet-string" aria-hidden="true"></span><span class="sheet-clip" aria-hidden="true"></span>
                  <div class="sheet-paper" data-cursor="Drag">
                    <div class="sheet-screen art art-tee" role="img" aria-label="Sample sports jersey for a sports club, number 10">
                      <span class="at-shirt">
                        <span class="at-stripe"></span>
                        <span class="at-club">PAGI<small>Sports club</small></span>
                        <span class="at-num">10</span>
                      </span>
                      <span class="at-label">Front</span>
                    </div>
                    <span class="sheet-caption">
                      <span class="sheet-idx">06</span>
                      <span class="sheet-name"><strong><span class="lang-id">Jersey olahraga</span><span class="lang-en">Sports jersey</span></strong><small><span class="lang-id">Kaos &amp; jersey</span><span class="lang-en">T-shirts &amp; jerseys</span></small></span>
                      <span class="sheet-tag">Sample</span>
                    </span>
                  </div>
                </div>
              </li>

              <!-- 07 Simple logo · 1:1 -->
              <li class="sheet" data-cat="logo" style="--tone:#f6efe4">
                <div class="sheet-swing">
                  <span class="sheet-string" aria-hidden="true"></span><span class="sheet-clip" aria-hidden="true"></span>
                  <div class="sheet-paper" data-cursor="Drag">
                    <div class="sheet-screen art art-logo" role="img" aria-label="Sample simple logo for a small bakery, with three colour versions">
                      <span class="al-mark">RM</span>
                      <span class="al-name">Roti Mekar</span>
                      <span class="al-tag">Bakery</span>
                      <span class="al-vars"><i><b></b></i><i><b></b></i><i><b></b></i></span>
                    </div>
                    <span class="sheet-caption">
                      <span class="sheet-idx">07</span>
                      <span class="sheet-name"><strong>Simple logo</strong><small><span class="lang-id">Untuk UMKM</span><span class="lang-en">For small businesses</span></small></span>
                      <span class="sheet-tag">Sample</span>
                    </span>
                  </div>
                </div>
              </li>

              <!-- The open slot: always last -->
              <li class="sheet sheet--next" style="--tone:#ff304f">
                <div class="sheet-swing">
                  <span class="sheet-string" aria-hidden="true"></span><span class="sheet-clip" aria-hidden="true"></span>
                  <div class="sheet-paper" data-cursor="Drag">
                    <span class="sheet-screen sheet-screen--next">
                      <span class="next-plus" aria-hidden="true">+</span>
                      <span class="next-title">Your design<br>is next<span class="accent-dot">.</span></span>
                    </span>
                    <span class="sheet-caption">
                      <span class="sheet-idx">08</span>
                      <span class="sheet-name"><strong><span class="lang-id">Slot terbuka</span><span class="lang-en">Open slot</span></strong><small><span class="lang-id">Mulai dari brief singkat</span><span class="lang-en">Starts with a quick brief</span></small></span>
                      <a class="sheet-go sheet-go--red" href="#contact" data-cursor="Let's talk" aria-label="Let's discuss your design">→</a>
                    </span>
                  </div>
                </div>
              </li>
            </ol>
          </div>
          <div class="hang-foot">
            <span class="hang-progress" aria-hidden="true"><i data-hang-bar></i></span>
            <span class="hang-hint" aria-hidden="true"><span class="lang-id">Geser</span><span class="lang-en">Drag</span> ↔</span>
          </div>
        </div>
        </div>
      </div>
    </section>

    <!-- ============ WHAT WE DESIGN — every category, written out ============ -->
    <section class="why" id="scope" aria-labelledby="scope-title">
      <div class="shell">
        <h2 class="section-title" id="scope-title" data-reveal-title>
          <span class="mask-line"><span>What we design<span class="accent-dot">.</span></span></span>
        </h2>

        <div class="bento bento--design">
          <a class="tile tile--wide tile--red reveal" href="#contact" data-spot data-cursor="Let's talk">
            <div class="viz viz-brief" aria-hidden="true">
              <span class="vb-inputs"><i>Logo</i><i><span class="lang-id">Foto produk</span><span class="lang-en">Product photos</span></i><i>Copy</i><i><span class="lang-id">Ide</span><span class="lang-en">Idea</span></i></span>
              <span class="vb-arrow"></span>
              <span class="vb-board"><i class="vb-a"></i><i class="vb-b"></i><i class="vb-c"></i><b>Aa</b></span>
            </div>
            <h3><span class="lang-id">Mulai dari apa saja.</span><span class="lang-en">Start from anything.</span></h3>
            <p class="tile-line"><span class="lang-id">Logo, foto produk, teks, atau baru sebatas ide. Tidak ada di daftar? Tanya saja.</span><span class="lang-en">A logo, product photos, copy, or just an idea. Not on the list? Just ask.</span></p>
            <span class="tile-go" aria-hidden="true">→</span>
          </a>
          <article class="tile reveal" id="cat-social" data-spot>
            <span class="tile-idx">01</span>
            <div class="viz viz-social" aria-hidden="true">
              <span class="vso-card"><i></i><b></b></span>
              <span class="vso-card"><i></i><b></b></span>
              <span class="vso-card"><i></i><b></b></span>
              <span class="vso-heart"></span>
            </div>
            <h3><span class="lang-id">Social media.</span><span class="lang-en">Social media.</span></h3>
            <ul class="tile-list">
              <li><span class="lang-id">Post &amp; carousel feed</span><span class="lang-en">Feed posts &amp; carousels</span></li>
              <li><span class="lang-id">Story &amp; cover reels</span><span class="lang-en">Stories &amp; reel covers</span></li>
              <li><span class="lang-id">Campaign visual</span><span class="lang-en">Campaign visuals</span></li>
              <li><span class="lang-id">Banner digital &amp; iklan</span><span class="lang-en">Digital banners &amp; ads</span></li>
              <li><span class="lang-id">Visual produk</span><span class="lang-en">Product visuals</span></li>
            </ul>
          </article>
          <article class="tile reveal" id="cat-sales" data-spot>
            <span class="tile-idx">02</span>
            <div class="viz viz-sales" aria-hidden="true">
              <span class="vsa-poster"><b>SALE</b><i></i><i></i></span>
              <span class="vsa-list"><i></i><i></i><i></i><i></i></span>
              <span class="vsa-tag">-30%</span>
            </div>
            <h3><span class="lang-id">Promosi &amp; penjualan.</span><span class="lang-en">Marketing &amp; sales.</span></h3>
            <ul class="tile-list">
              <li><span class="lang-id">Poster &amp; sales poster</span><span class="lang-en">Posters &amp; sales posters</span></li>
              <li><span class="lang-id">Flyer</span><span class="lang-en">Flyers</span></li>
              <li><span class="lang-id">Price list</span><span class="lang-en">Price lists</span></li>
              <li><span class="lang-id">Katalog produk</span><span class="lang-en">Product catalogues</span></li>
              <li><span class="lang-id">Menu</span><span class="lang-en">Menus</span></li>
              <li><span class="lang-id">Materi promosi lainnya</span><span class="lang-en">Other promo materials</span></li>
            </ul>
          </article>
          <article class="tile reveal" id="cat-docs" data-spot>
            <span class="tile-idx">03</span>
            <div class="viz viz-deck" aria-hidden="true">
              <span class="vd-stack"><i></i><i></i><i><b>Q4</b><em></em></i></span>
              <span class="vd-pages"><i></i><i></i><i></i></span>
            </div>
            <h3><span class="lang-id">Presentasi &amp; dokumen.</span><span class="lang-en">Presentations &amp; documents.</span></h3>
            <ul class="tile-list">
              <li><span class="lang-id">Company profile</span><span class="lang-en">Company profiles</span></li>
              <li><span class="lang-id">Sales deck &amp; presentasi</span><span class="lang-en">Sales decks &amp; presentations</span></li>
              <li><span class="lang-id">Proposal</span><span class="lang-en">Proposals</span></li>
              <li><span class="lang-id">Booklet</span><span class="lang-en">Booklets</span></li>
              <li><span class="lang-id">Menu book</span><span class="lang-en">Menu books</span></li>
            </ul>
          </article>
          <article class="tile reveal" id="cat-print" data-spot>
            <span class="tile-idx">04</span>
            <div class="viz viz-print" aria-hidden="true">
              <span class="vp-card"><i></i><b>&amp;</b><i></i></span>
              <span class="vp-flyer"><b></b><i></i><i></i><i></i></span>
            </div>
            <h3><span class="lang-id">Cetak &amp; event.</span><span class="lang-en">Print &amp; events.</span></h3>
            <ul class="tile-list">
              <li><span class="lang-id">Undangan pernikahan &amp; acara</span><span class="lang-en">Wedding &amp; event invitations</span></li>
              <li><span class="lang-id">Backdrop &amp; photobooth</span><span class="lang-en">Backdrops &amp; photo booths</span></li>
              <li><span class="lang-id">Banner, spanduk &amp; X-banner</span><span class="lang-en">Banners &amp; roll-up banners</span></li>
              <li><span class="lang-id">Booth &amp; signage</span><span class="lang-en">Booths &amp; signage</span></li>
              <li><span class="lang-id">Flyer &amp; brosur cetak</span><span class="lang-en">Printed flyers &amp; brochures</span></li>
              <li><span class="lang-id">Materi cetak lainnya</span><span class="lang-en">Other print materials</span></li>
            </ul>
          </article>
          <article class="tile reveal" id="cat-apparel" data-spot>
            <span class="tile-idx">05</span>
            <div class="viz viz-apparel" aria-hidden="true">
              <span class="vp-tee"><b>07</b></span>
              <span class="vp-tee vp-tee--red"><i></i></span>
            </div>
