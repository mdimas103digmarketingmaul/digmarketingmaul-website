        <div class="footer-top-link">
          <a href="#" class="back-to-top"><span aria-hidden="true">↑</span> Back to top</a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>© 2026 Build and Design by Maul</p>
        <img class="footer-mark" src="/assets/brand/logo/icon.svg" alt="" width="26" height="26">
