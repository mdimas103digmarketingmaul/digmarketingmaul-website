---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import adsInitScript from '../../../scripts/products/ads-init.js?raw';
import adsInternationalConfigScript from '../../../scripts/products/ads-international-config.js?raw';
const meta = {
  "title": "Digital Ads Management — Maul Digital",
  "themeColor": "#f7f8fb",
  "description": "Digital Ads Management oleh Maul — pengelolaan campaign, measurement, tracking, creative direction, optimization, reporting, dan business insight berbasis data.",
  "canonical": "/products/digital-ads-management/"
};
---
<BaseLayout meta={meta} lang="id" htmlAttributes={{"data-theme": "light", "data-language": "id"}} bodyAttributes={{}}>
<Fragment slot="head">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/compact-controls.css">
<link rel="stylesheet" href="/assets/product-detail-international.css">
<link rel="stylesheet" href="/products/digital-ads-management/styles.css">
<script is:inline set:html={adsInitScript}></script>
</Fragment>
<div class="grid-bg" aria-hidden="true"></div>
<a class="skip-link" href="#main"><span class="lang-id">Langsung ke konten</span><span class="lang-en">Skip to content</span></a>

<header class="topbar">
  <div class="shell topbar-inner">
    <div class="product-detail-header-left">
      <a class="brand" href="/" aria-label="digmarketingmaul Home"><img class="brand-logo-light" src="/assets/brand/logo/icon.svg" alt="digmarketingmaul" width="36" height="36"><img class="brand-logo-dark" src="/assets/brand/logo/icon-reversed.svg" alt="digmarketingmaul" width="36" height="36"></a>
      <div class="product-detail-header-controls" aria-label="Product display controls">
        <button aria-pressed="false" class="product-international-toggle" type="button" data-product-international-toggle aria-label="Toggle international mode">
          <span aria-hidden="true" class="pit-track"><span></span></span><span class="product-international-label">International</span>
        </button>
        <div class="maul-compact-controls" aria-label="Display controls">
          <select class="maul-compact-select maul-language-select" data-maul-language-select aria-label="Language"><option value="id">ID</option><option value="en">EN</option></select>
          <button class="maul-dark-toggle" type="button" data-maul-dark-toggle aria-pressed="false" aria-label="Enable dark mode"><span class="maul-dark-toggle-track" aria-hidden="true"><span></span></span><span>Dark</span></button>
        </div>
      </div>
    </div>
    <nav class="page-nav" aria-label="On this page">
      <a href="#areas"><span class="lang-id">Scope</span><span class="lang-en">Scope</span></a>
      <a href="#measurement">Measurement</a>
      <a href="#packages"><span class="lang-id">Paket</span><span class="lang-en">Packages</span></a>
      <a href="#fee">Fee</a>
    </nav>
    <div class="nav-actions">
      <a class="nav-link" href="/products/"><span class="lang-id">← Kembali ke Products</span><span class="lang-en">← Back to Products</span></a>
      <a class="btn btn-primary" data-wa="general" href="https://wa.me/6281296069566?text=Halo%20Maul%2C%20saya%20tertarik%20dengan%20layanan%20Digital%20Ads%20Management." target="_blank" rel="noopener noreferrer"><span class="lang-id">Diskusi via WhatsApp</span><span class="lang-en">Discuss via WhatsApp</span></a>
    </div>
  </div>
</header>

<main id="main">

  <!-- ================= HERO + SYSTEM MAP ================= -->
  <section class="hero">
    <div class="shell">
      <div class="hero-top">
        <div class="hero-copy">
          <p class="eyebrow">Digital Ads Management</p>
          <h1><span class="lang-id">Kelola ads sebagai sistem<b class="dot">.</b></span><span class="lang-en">Run ads as a system<b class="dot">.</b></span></h1>
        </div>
        <div class="hero-side">
          <p class="lead">
            <span class="lang-id">Bukan sekadar setup dan optimasi campaign. Maul mengelola <strong>tujuh area yang saling terhubung</strong>—dari fondasi akun dan measurement, campaign dan creative, sampai analisis, business insight, dan eksperimen.</span>
            <span class="lang-en">Not just campaign setup and optimization. Maul manages <strong>seven connected areas</strong>—from account foundations and measurement, campaigns and creative, through analysis, business insight, and experimentation.</span>
          </p>
          <div class="actions">
            <a class="btn btn-primary btn-lg" href="#brief">
              <span class="lang-id">Susun brief diskusi</span><span class="lang-en">Build a discussion brief</span><span class="arrow" aria-hidden="true">↓</span>
            </a>
            <a class="btn btn-whatsapp btn-lg" data-wa="general" href="https://wa.me/6281296069566?text=Halo%20Maul%2C%20saya%20tertarik%20dengan%20layanan%20Digital%20Ads%20Management." target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.3 7.4L3 21l2.1-5.6A8.4 8.4 0 1 1 21 11.5z"/></svg>
              <span class="lang-id">Chat langsung</span><span class="lang-en">Chat directly</span>
            </a>
          </div>
        </div>
      </div>

      <div class="system" data-system>
        <div class="system-map">
          <svg class="ring" viewBox="0 0 100 100" aria-hidden="true">
            <circle class="ring-track" cx="50" cy="50" r="42"/>
            <circle class="ring-pulse" cx="50" cy="50" r="42" pathLength="100"/>
          </svg>
          <div class="ring-center" aria-hidden="true">
            <span class="ring-kicker"><span class="lang-id">Pusat sistem</span><span class="lang-en">System core</span></span>
            <strong><span class="lang-id">Objective &amp; KPI bisnis</span><span class="lang-en">Business objective &amp; KPI</span></strong>
            <small>data → insight → action</small>
          </div>
          <button class="node is-active" type="button" style="--x:50%;--y:8%" data-node="0" aria-label="01 Foundation & Account Setup">01</button>
          <button class="node" type="button" style="--x:82.84%;--y:23.81%" data-node="1" aria-label="02 Measurement & Tracking">02</button>
          <button class="node" type="button" style="--x:90.95%;--y:59.35%" data-node="2" aria-label="03 Campaign Ads Management">03</button>
          <button class="node" type="button" style="--x:68.22%;--y:87.84%" data-node="3" aria-label="04 Creative & Content Strategy">04</button>
          <button class="node node--p23" type="button" style="--x:31.78%;--y:87.84%" data-node="4" aria-label="05 Creative Materials Creation">05</button>
          <button class="node" type="button" style="--x:9.05%;--y:59.35%" data-node="5" aria-label="06 Dashboard, Analysis & Business Insight">06</button>
          <button class="node node--p3" type="button" style="--x:17.16%;--y:23.81%" data-node="6" aria-label="07 Experimentation & A/B Testing">07</button>
        </div>

        <div class="system-legend">
          <div class="legend-head">
            <span class="lang-id">Tujuh area utama pengelolaan</span><span class="lang-en">Seven core management areas</span>
            <span class="legend-key"><i class="k-all"></i><span class="lang-id">Semua paket</span><span class="lang-en">All packages</span><i class="k-p23"></i>Growth+<i class="k-p3"></i>Scale</span>
          </div>
          <ol class="legend-list">
            <li class="is-active" data-legend="0"><a href="#area-01"><span class="lg-num">01</span><span class="lg-body"><strong>Foundation &amp; Account Setup</strong><small><span class="lang-id">Struktur akun, akses, billing, dan fondasi campaign.</span><span class="lang-en">Account structure, access, billing, and campaign foundations.</span></small></span><i class="lg-dot k-all"></i></a></li>
            <li data-legend="1"><a href="#area-02"><span class="lg-num">02</span><span class="lg-body"><strong>Measurement &amp; Tracking</strong><small><span class="lang-id">Langkah penting di customer journey terukur dengan tepat.</span><span class="lang-en">Key customer-journey steps measured properly.</span></small></span><i class="lg-dot k-all"></i></a></li>
            <li data-legend="2"><a href="#area-03"><span class="lg-num">03</span><span class="lg-body"><strong>Campaign Ads Management</strong><small><span class="lang-id">Setup, budget, optimasi harian, troubleshooting.</span><span class="lang-en">Setup, budget, daily optimization, troubleshooting.</span></small></span><i class="lg-dot k-all"></i></a></li>
            <li data-legend="3"><a href="#area-04"><span class="lg-num">04</span><span class="lg-body"><strong>Creative &amp; Content Strategy</strong><small><span class="lang-id">Pesan, angle, hook, dan format berbasis performance.</span><span class="lang-en">Message, angle, hook, and format driven by performance.</span></small></span><i class="lg-dot k-all"></i></a></li>
            <li data-legend="4"><a href="#area-05"><span class="lg-num">05</span><span class="lg-body"><strong>Creative Materials Creation</strong><small><span class="lang-id">Static, carousel, motion/video, dan ad copy.</span><span class="lang-en">Static, carousel, motion/video, and ad copy.</span></small></span><i class="lg-dot k-p23"></i></a></li>
            <li data-legend="5"><a href="#area-06"><span class="lg-num">06</span><span class="lg-body"><strong>Dashboard, Analysis &amp; Business Insight</strong><small><span class="lang-id">Data diubah jadi rekomendasi untuk pertumbuhan bisnis.</span><span class="lang-en">Data turned into recommendations for business growth.</span></small></span><i class="lg-dot k-all"></i></a></li>
            <li data-legend="6"><a href="#area-07"><span class="lg-num">07</span><span class="lg-body"><strong>Experimentation &amp; A/B Testing</strong><small><span class="lang-id">Hypothesis, test, dan learning untuk optimasi berikutnya.</span><span class="lang-en">Hypotheses, tests, and learning for the next optimization.</span></small></span><i class="lg-dot k-p3"></i></a></li>
          </ol>
        </div>
      </div>

      <ul class="platforms" aria-label="Focus">
        <li>Meta Ads</li><li>Google Ads</li><li>Tracking &amp; Measurement</li><li>Creative</li><li>Insight &amp; Growth</li>
      </ul>
    </div>
  </section>

  <!-- ================= SEVEN AREAS LEDGER ================= -->
  <section class="section" id="areas" aria-labelledby="areas-title">
    <div class="shell">
      <header class="section-head reveal">
        <div>
          <p class="eyebrow">Scope of service</p>
          <h2 class="title" id="areas-title"><span class="lang-id">Apa yang benar-benar dikelola Maul.</span><span class="lang-en">What Maul actually manages.</span></h2>
        </div>
        <div class="head-side">
          <p class="section-intro"><span class="lang-id">Tujuh area, dikelompokkan dalam tiga lapisan kerja. Buka tiap area untuk melihat rincian pekerjaannya.</span><span class="lang-en">Seven areas, grouped into three working layers. Open any area to see the detailed work.</span></p>
          <button class="toggle-all" type="button" data-toggle-all aria-pressed="false"><span class="ta-open"><span class="lang-id">Buka semua area</span><span class="lang-en">Expand all areas</span></span><span class="ta-close"><span class="lang-id">Tutup semua</span><span class="lang-en">Collapse all</span></span></button>
        </div>
      </header>

      <div class="ledger">
        <!-- Layer: foundation -->
        <div class="layer-group reveal">
          <p class="layer-tag"><span class="lang-id">Fondasi</span><span class="lang-en">Foundation</span><small><span class="lang-id">Siap jalan &amp; bisa diukur</span><span class="lang-en">Ready to run &amp; measurable</span></small></p>
          <div class="layer-rows">
            <details class="area" id="area-01" open>
              <summary>
                <span class="area-num">01</span>
                <span class="area-head"><strong>Foundation &amp; Account Setup</strong><span><span class="lang-id">Fondasi iklan yang rapi, aman, dan siap jalan.</span><span class="lang-en">A clean, secure ad foundation that's ready to run.</span></span></span>
                <span class="badge badge-all"><span class="lang-id">Semua paket</span><span class="lang-en">All packages</span></span>
                <span class="chev" aria-hidden="true"></span>
              </summary>
              <div class="area-body">
                <ul class="ticks">
                  <li><span class="lang-id">Memahami bisnis, produk, funnel, objective, dan KPI utama.</span><span class="lang-en">Understand the business, product, funnel, objectives, and key KPIs.</span></li>
                  <li><span class="lang-id">Audit akun dan aset digital yang sudah ada.</span><span class="lang-en">Audit existing accounts and digital assets.</span></li>
                  <li><span class="lang-id">Setup akun iklan (Meta Ads, Google Ads, dll.), akses, verifikasi, dan billing.</span><span class="lang-en">Ad-account setup (Meta Ads, Google Ads, etc.), access, verification, and billing.</span></li>
                  <li><span class="lang-id">Struktur campaign, naming convention, dan audience dasar.</span><span class="lang-en">Campaign structure, naming conventions, and initial audiences.</span></li>
                </ul>
              </div>
            </details>
            <details class="area" id="area-02">
              <summary>
                <span class="area-num">02</span>
                <span class="area-head"><strong>Measurement &amp; Tracking</strong><span><span class="lang-id">Aktivitas penting, dari traffic sampai conversion, bisa diukur dan dipakai untuk optimasi.</span><span class="lang-en">Key activity, from traffic to conversion, is measured and usable for optimization.</span></span></span>
                <span class="badge badge-all"><span class="lang-id">Semua paket</span><span class="lang-en">All packages</span></span>
                <span class="chev" aria-hidden="true"></span>
              </summary>
              <div class="area-body">
                <ul class="ticks">
                  <li><span class="lang-id">Measurement plan dan event mapping dari top hingga bottom funnel.</span><span class="lang-en">Measurement plan and event mapping from top to bottom funnel.</span></li>
                  <li><span class="lang-id">Validasi event dan cek kualitas data secara berkala.</span><span class="lang-en">Regular event validation and data-quality checks.</span></li>
                  <li><span class="lang-id">Stack disesuaikan dengan ekosistem: Website, App, CTWA/WhatsApp, Marketplace/Offline.</span><span class="lang-en">Stack adapted to your ecosystem: Website, App, CTWA/WhatsApp, Marketplace/Offline.</span></li>
                </ul>
                <a class="text-link" href="#measurement"><span class="lang-id">Lihat peta measurement</span><span class="lang-en">See the measurement map</span> ↓</a>
              </div>
            </details>
          </div>
        </div>

        <!-- Layer: execution -->
        <div class="layer-group reveal">
          <p class="layer-tag"><span class="lang-id">Eksekusi</span><span class="lang-en">Execution</span><small><span class="lang-id">Campaign &amp; creative berjalan</span><span class="lang-en">Campaigns &amp; creative in motion</span></small></p>
          <div class="layer-rows">
            <details class="area" id="area-03">
              <summary>
                <span class="area-num">03</span>
                <span class="area-head"><strong>Campaign Ads Management</strong><span><span class="lang-id">Campaign tetap terkontrol, sehat, dan sesuai objective.</span><span class="lang-en">Campaigns stay controlled, healthy, and on-objective.</span></span></span>
                <span class="badge badge-all"><span class="lang-id">Semua paket</span><span class="lang-en">All packages</span></span>
                <span class="chev" aria-hidden="true"></span>
              </summary>
              <div class="area-body">
                <dl class="kv">
                  <div><dt>Setup</dt><dd><span class="lang-id">Objective, audience, placement, bidding, jadwal.</span><span class="lang-en">Objective, audience, placement, bidding, scheduling.</span></dd></div>
                  <div><dt>Budget</dt><dd><span class="lang-id">Alokasi, pacing, dan redistribusi bila perlu.</span><span class="lang-en">Allocation, pacing, and redistribution when needed.</span></dd></div>
                  <div><dt>Lifecycle</dt><dd><span class="lang-id">Aktivasi, pause, scaling, restructuring.</span><span class="lang-en">Activation, pausing, scaling, restructuring.</span></dd></div>
                  <div><dt>Troubleshooting</dt><dd><span class="lang-id">Delivery, iklan ditolak, billing, akses.</span><span class="lang-en">Delivery, ad rejections, billing, access.</span></dd></div>
                  <div><dt><span class="lang-id">Administrasi</span><span class="lang-en">Administration</span></dt><dd><span class="lang-id">Rekap spend dan invoice platform.</span><span class="lang-en">Spend recaps and platform invoices.</span></dd></div>
                </dl>
              </div>
            </details>
            <details class="area" id="area-04">
              <summary>
                <span class="area-num">04</span>
                <span class="area-head"><strong>Creative &amp; Content Strategy</strong><span><span class="lang-id">Material iklan punya arah jelas dan terus berkembang.</span><span class="lang-en">Ad materials have clear direction and keep improving.</span></span></span>
                <span class="badge badge-all"><span class="lang-id">Semua paket</span><span class="lang-en">All packages</span></span>
                <span class="chev" aria-hidden="true"></span>
              </summary>
              <div class="area-body">
                <ul class="ticks">
                  <li><span class="lang-id">Menentukan messaging, angle, hook, offer, CTA, dan format.</span><span class="lang-en">Define messaging, angles, hooks, offers, CTAs, and formats.</span></li>
                  <li><span class="lang-id">Membaca creative winner, fatigue, dan respons audience.</span><span class="lang-en">Read creative winners, fatigue, and audience response.</span></li>
                  <li><span class="lang-id">Creative brief dan rekomendasi iterasi berikutnya.</span><span class="lang-en">Creative briefs and next-iteration recommendations.</span></li>
                  <li><span class="lang-id">Asset bisa dipakai juga untuk organic social bila sesuai.</span><span class="lang-en">Assets can also be used for organic social where relevant.</span></li>
                </ul>
              </div>
            </details>
            <details class="area" id="area-05">
              <summary>
                <span class="area-num">05</span>
                <span class="area-head"><strong>Creative Materials Creation</strong><span><span class="lang-id">Asset siap pakai untuk menjalankan dan mengoptimasi campaign.</span><span class="lang-en">Ready-to-run assets to launch and optimize campaigns.</span></span></span>
                <span class="badge badge-p23">Growth &amp; Scale</span>
                <span class="chev" aria-hidden="true"></span>
              </summary>
              <div class="area-body">
                <ul class="format-row" aria-label="Formats">
                  <li>Static visual</li><li>Carousel</li><li>Motion</li><li>Short video</li><li>Ad copy</li>
                </ul>
                <ul class="ticks">
                  <li><span class="lang-id">Variasi creative untuk testing.</span><span class="lang-en">Creative variations for testing.</span></li>
                  <li><span class="lang-id">Adaptasi ukuran untuk tiap placement dan platform.</span><span class="lang-en">Size adaptations for each placement and platform.</span></li>
                  <li><span class="lang-id">Volume dan kompleksitas disepakati per bulan.</span><span class="lang-en">Volume and complexity agreed monthly.</span></li>
                </ul>
              </div>
            </details>
          </div>
        </div>

        <!-- Layer: learn -->
        <div class="layer-group reveal">
          <p class="layer-tag"><span class="lang-id">Belajar &amp; tumbuh</span><span class="lang-en">Learn &amp; grow</span><small><span class="lang-id">Data menjadi keputusan</span><span class="lang-en">Data becomes decisions</span></small></p>
          <div class="layer-rows">
            <details class="area" id="area-06">
              <summary>
                <span class="area-num">06</span>
                <span class="area-head"><strong>Dashboard, Analysis &amp; Business Insight</strong><span><span class="lang-id">Data diubah menjadi insight dan keputusan yang mendorong pertumbuhan bisnis.</span><span class="lang-en">Data turned into insight and decisions that drive business growth.</span></span></span>
                <span class="badge badge-all"><span class="lang-id">Semua paket</span><span class="lang-en">All packages</span></span>
                <span class="chev" aria-hidden="true"></span>
              </summary>
              <div class="area-body">
                <dl class="kv">
                  <div><dt>Traffic</dt><dd><span class="lang-id">Impression, CPM, CTR, CPC, kualitas traffic.</span><span class="lang-en">Impressions, CPM, CTR, CPC, traffic quality.</span></dd></div>
                  <div><dt>Conversion</dt><dd>CVR, lead, purchase, CPA/CPL, ROAS.</dd></div>
                  <div><dt>Funnel</dt><dd><span class="lang-id">Menemukan bottleneck dari awareness ke conversion.</span><span class="lang-en">Find bottlenecks from awareness to conversion.</span></dd></div>
                  <div><dt><span class="lang-id">Rekomendasi</span><span class="lang-en">Recommendation</span></dt><dd><span class="lang-id">Apa yang di-scale, diperbaiki, diuji ulang, atau dihentikan—termasuk landing page, offer, dan funnel.</span><span class="lang-en">What to scale, fix, retest, or stop—including landing page, offer, and funnel.</span></dd></div>
                </dl>
                <a class="text-link" href="#decision"><span class="lang-id">Lihat ritme review</span><span class="lang-en">See the review rhythm</span> ↓</a>
              </div>
            </details>
            <details class="area" id="area-07">
              <summary>
                <span class="area-num">07</span>
                <span class="area-head"><strong>Experimentation &amp; A/B Testing</strong><span><span class="lang-id">Continuous learning, sehingga optimasi tidak hanya berdasarkan asumsi.</span><span class="lang-en">Continuous learning, so optimization isn't based on assumptions alone.</span></span></span>
                <span class="badge badge-p3">Scale</span>
                <span class="chev" aria-hidden="true"></span>
              </summary>
              <div class="area-body">
                <ol class="loop" aria-label="Experiment loop">
                  <li><span class="lang-id">Hypothesis dari data</span><span class="lang-en">Hypothesis from data</span></li>
                  <li><span class="lang-id">Pilih variabel</span><span class="lang-en">Choose the variable</span></li>
                  <li><span class="lang-id">Tentukan success metric</span><span class="lang-en">Set the success metric</span></li>
                  <li><span class="lang-id">Jalankan test dengan setup jelas</span><span class="lang-en">Run a clearly set-up test</span></li>
                  <li><span class="lang-id">Evaluasi: scale, iterate, atau stop</span><span class="lang-en">Evaluate: scale, iterate, or stop</span></li>
                  <li><span class="lang-id">Dokumentasikan learning</span><span class="lang-en">Document the learning</span></li>
                </ol>
              </div>
            </details>
          </div>
        </div>
      </div>

      <p class="scope-note reveal"><span class="lang-id"><strong>Catatan scope:</strong> Cakupan final, volume pekerjaan, platform, dan cadence pengelolaan dikonfirmasi bersama sebelum mulai.</span><span class="lang-en"><strong>Scope note:</strong> Final scope, workload, platforms, and management cadence are confirmed together before work starts.</span></p>
    </div>
  </section>

  <!-- ================= MEASUREMENT ================= -->
  <section class="section measure" id="measurement" aria-labelledby="measure-title">
    <div class="shell">
      <header class="section-head reveal">
        <div>
          <p class="eyebrow">Measurement &amp; insight</p>
          <h2 class="title" id="measure-title"><span class="lang-id">Dari tempat customer berinteraksi, sampai keputusan berikutnya.</span><span class="lang-en">From where customers act, to the next decision.</span></h2>
        </div>
        <div class="head-side">
          <p class="section-intro"><span class="lang-id">Tujuannya bukan memasang semua tools, tetapi memastikan event yang penting untuk keputusan bisnis benar-benar terbaca—sesuai channel, funnel, dan data yang tersedia.</span><span class="lang-en">The goal isn't to install every tool, but to make sure the events that matter for business decisions are actually readable—based on your channels, funnel, and available data.</span></p>
        </div>
      </header>

      <div class="flow reveal">
        <div class="flow-cols" aria-hidden="true">
          <span><i>A</i><span class="lang-id">Di mana customer berinteraksi</span><span class="lang-en">Where customers act</span></span>
          <span><i>B</i><span class="lang-id">Stack yang dipakai</span><span class="lang-en">Measurement stack</span></span>
          <span><i>C</i><span class="lang-id">Yang bisa dibaca</span><span class="lang-en">What becomes readable</span></span>
        </div>

        <article class="lane">
