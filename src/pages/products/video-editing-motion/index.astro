            <li><a href="https://www.youtube.com/@digmarketingmaul" target="_blank" rel="noopener noreferrer" class="footer-link"><i class="fa-brands fa-youtube" aria-hidden="true"></i> YouTube</a></li>
          </ul>
        </div>
        <div>
          <p class="footer-label">Based in</p>
