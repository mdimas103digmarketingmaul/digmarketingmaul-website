          <li data-reveal>
            <details class="cert" data-preview="./assets/images/certifications/google-ads-search-2021.png">
              <summary class="cert-row"><span class="cert-index">05</span><span class="cert-name">Google Ads Search Certification</span><span class="cert-year">2021</span><span class="cert-toggle" aria-hidden="true"></span></summary>
              <div class="cert-body"><img src="/assets/images/certifications/google-ads-search-2021.png" alt="Google Ads Search Certification 2021" loading="lazy" decoding="async"></div>
            </details>
          </li>
          <li data-reveal>
            <details class="cert" data-preview="./assets/images/certifications/google-ads-display.png">
