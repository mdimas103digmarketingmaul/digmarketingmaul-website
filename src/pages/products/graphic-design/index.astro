---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { serviceGraph } from '../../../data/structured-data.js';
import initScript from '../../../scripts/products/product-page-init.js?raw';
import baseCss from '../../../styles/products/website-development.css?url';
import pageCss from '../../../styles/products/graphic-design.css?url';
import pageJs from '../../../scripts/products/graphic-design.js?url';
import WorkSheet from '../../../components/products/WorkSheet.astro';
// One source for the visible FAQ and its JSON-LD. Answers may hold inline HTML (links).
const plain = (html) => html.replace(/<[^>]+>/g, "").replace(/&amp;/g, "&").trim();
const faq = [
  {
    "id": {
      "q": "Apa yang perlu saya siapkan?",
      "a": [
        "Logo, foto produk, teks, dan referensi, kalau sudah ada.",
        "Belum lengkap? Tidak apa-apa, kita mulai dari brief."
      ]
    },
    "en": {
      "q": "What should I prepare?",
      "a": [
        "Your logo, product photos, copy and references, if you have them.",
        "Not everything ready? That's fine, we start from the brief."
      ]
    }
  },
  {
    "id": {
      "q": "Bisa untuk digital dan cetak?",
      "a": [
        "Bisa. File disiapkan sesuai media: ukuran untuk sosial media atau iklan, dan versi siap cetak sesuai spesifikasi percetakanmu."
      ]
    },
    "en": {
      "q": "Digital and print?",
      "a": [
        "Yes. Files are prepared for where they'll be used: sized for social media or ads, and print-ready to your printer's specs."
      ]
    }
  },
  {
    "id": {
      "q": "File apa yang saya terima?",
      "a": [
        "Umumnya PNG atau JPG untuk digital dan PDF untuk cetak. Format lain bisa disepakati di awal."
      ]
    },
    "en": {
      "q": "Which files do I get?",
      "a": [
        "Usually PNG or JPG for digital and PDF for print. Other formats can be agreed up front."
      ]
    }
  },
  {
    "id": {
      "q": "Berapa lama pengerjaannya?",
      "a": [
        "Tergantung jenis dan jumlah desain. Estimasi waktu disampaikan setelah brief."
      ]
    },
    "en": {
      "q": "How long does it take?",
      "a": [
        "It depends on the type and number of designs. You get a time estimate after the brief."
      ]
    }
  },
  {
    "id": {
      "q": "Bagaimana dengan revisi?",
      "a": [
        "Revisi sesuai yang kamu mau, jumlahnya tidak dibatasi. Kamu bayar hanya setelah desainnya sesuai dengan brief yang kamu sampaikan."
      ]
    },
    "en": {
      "q": "What about revisions?",
      "a": [
        "Ask for as many revisions as you need. You only pay once the design matches the brief you gave."
      ]
    }
  },
  {
    "id": {
      "q": "Logo seperti apa yang dibuat?",
      "a": [
        "Simple logo: logo sederhana dan rapi untuk UMKM atau usaha yang baru mulai."
      ]
    },
    "en": {
      "q": "What kind of logo do you make?",
      "a": [
        "A simple, clean logo for small businesses or ones just starting out."
      ]
    }
  },
  {
    "id": {
      "q": "Pembeli dari luar Indonesia?",
      "a": [
        "Bisa. Bayar dengan PayPal, Visa, Mastercard, atau metode internasional lain."
      ]
    },
    "en": {
      "q": "Buying from outside Indonesia?",
      "a": [
        "Yes. Pay with PayPal, Visa, Mastercard or other international methods."
      ]
    }
  },
  {
    "id": {
      "q": "Butuh video atau website juga?",
      "a": [
        "Bisa. Lihat <a href=\"/products/video-editing-motion/\">Video Editing &amp; Motion</a> dan <a href=\"/products/website-development/\">Website Development</a>."
      ]
    },
    "en": {
      "q": "Need video or a website too?",
      "a": [
        "Yes. See <a href=\"/products/video-editing-motion/\">Video Editing &amp; Motion</a> and <a href=\"/products/website-development/\">Website Development</a>."
      ]
    }
  }
];
// Real client work on the hero rail. One work = one sheet (src/components/products/WorkSheet.astro):
// `card` is the small image that hangs, `images` what the viewer shows, top to bottom.
// The rail shows them in the order written here (categories, and works within them).
// The hero opens on the overview wall (every image, small); a tile opens the rail at its work.
// Sizes are the files' real pixel sizes. Files + how to make them: docs/graphic-design.md
const GD = "/assets/graphic-design/";
const pic = (file, w, h, alt = "") => ({ src: GD + file, w, h, alt });
const works = {
  packaging: [
    {
      key: "meutuah-drip", name: "Drip bag", client: "Meutuah 1978",
      title: { id: "Sachet drip bag: Lintong, Gayo, Mandheling", en: "Drip bag sachets: Lintong, Gayo, Mandheling" },
      card: pic("packaging/meutuah-drip-bags-card.webp", 800, 800),
      images: [
        pic("packaging/meutuah-drip-bags.webp", 1600, 1600, "Meutuah 1978 drip bag sachets in green, orange and yellow, illustrated with coffee pickers, laid out on a wooden table beside a white box and coffee beans"),
        pic("packaging/meutuah-drip-post.webp", 1080, 1350, "Social post introducing the Meutuah Coffee Drip: three sachets, Lintong, Mandheling and Gayo, on green beside a cup of coffee"),
        pic("packaging/meutuah-drip-box-set.webp", 1600, 1600, "Stacked Meutuah 1978 boxes with drip bag sachets, a moka pot and a drip bag brewing in a glass"),
      ],
    },
    {
      key: "meutuah-box", name: { id: "Box & pouch", en: "Box & pouch" }, client: "Meutuah 1978",
      title: { id: "Box & pouch: satu lini produk", en: "Box & pouch: one product line" },
      card: pic("packaging/meutuah-product-line-card.webp", 800, 800),
      images: [
        pic("packaging/meutuah-product-line.webp", 1600, 1600, "The Meutuah 1978 product line: white stand-up pouches with illustrated labels, the white box and drip bag sachets, with a French press and beans"),
        pic("packaging/meutuah-box-front.webp", 1600, 1600, "The Meutuah 1978 box: white with a dark green panel, the logo and the 100% Arabica coffee drip label, next to a drip bag brewing"),
        pic("packaging/meutuah-box-side.webp", 1600, 1600, "The side of the Meutuah 1978 box with the brewing guide, storage notes and composition, next to a drip bag and coffee beans"),
        pic("packaging/meutuah-box-story.webp", 1600, 1600, "The top of the Meutuah 1978 box with the brand story, among scattered coffee beans and a French press"),
      ],
    },
  ],
  apparel: [
    {
      key: "hijra-runner", name: { id: "Jersey lari", en: "Running jersey" }, client: "Hijra Bank · Hijra Runner",
      title: { id: "10 konsep dipresentasikan, lalu final", en: "10 concepts presented, then the final" },
      card: pic("apparel/hijra-runner-jersey-card.webp", 800, 983),
      images: [pic("apparel/hijra-runner-jersey.webp", 1600, 1966, "Hijra Runner running jersey: an overview of the ten concepts presented, above the final chosen design, Chevron Rush, in deep teal with a chevron pattern, front and back")],
    },
    {
      key: "hijra-football", name: { id: "Jersey sepak bola", en: "Football kit" }, client: "Hijra Bank",
      title: { id: "Jersey sepak bola: depan, belakang & celana", en: "Football kit: front, back & shorts" },
      card: pic("apparel/hijra-football-kit-card.webp", 800, 1000),
      images: [pic("apparel/hijra-football-kit.webp", 1600, 2000, "Hijra Bank football kit in sky blue with navy trim: the front with the Hijra logo and club badge, the back with name and number 6, and navy shorts with a blue side stripe")],
    },
    {
      key: "ptm-baposa", name: { id: "Jersey tenis meja", en: "Table tennis jersey" }, client: "PTM Baposa",
      title: { id: "Jersey tenis meja, depan & belakang", en: "Table tennis jersey, front & back" },
      card: pic("apparel/ptm-baposa-jersey-card.webp", 800, 511),
      images: [pic("apparel/ptm-baposa-jersey.webp", 1600, 1021, "PTM Baposa table tennis jersey in navy with a blue brush pattern: the front with the club badge and PTM BAPOSA, the back with BAPOSA written down the spine")],
    },
  ],
  logo: [
    {
      key: "meutuah-logo", name: "Logo", client: "Meutuah 1978",
      title: { id: "Logo: vertikal & horizontal, latar terang & gelap", en: "Logo: vertical & horizontal, on light & dark" },
      card: pic("logo/meutuah-1978-logo-card.webp", 800, 1000),
      images: [pic("logo/meutuah-1978-logo.webp", 1600, 2000, "Meutuah 1978 logo system: the vertical and horizontal versions, each in green on white and in white on green, with the brand colours")],
    },
    {
      key: "gals-logo", name: "Logo", client: "Gals Episode",
      title: { id: "Logo: 4 versi, filosofi & opsi yang dibuat", en: "Logo: 4 versions, the philosophy & the options" },
      card: pic("logo/gals-episode-logo-card.webp", 800, 800),
      images: [
        pic("logo/gals-episode-logo.webp", 1600, 1600, "Gals Episode logo in four versions: the gradient primary, one colour on white, white on dark, and white on the brand magenta"),
        pic("logo/gals-episode-philosophy.webp", 1600, 1600, "Gals Episode logo philosophy: the letters G and E, a butterfly shape, the colour #231F20 and the Minion Variable Concept font"),
        pic("logo/gals-episode-options.webp", 1600, 1600, "The three logo options created for Gals Episode, a butterfly, a tulip and a rose, each with its meaning"),
      ],
    },
  ],
  sales: [
    {
      key: "meutuah-price-list", name: "Price list", client: "Meutuah 1978",
      title: { id: "Price list kopi specialty, Triple Pick", en: "Specialty coffee price list, Triple Pick" },
      card: pic("sales/meutuah-1978-price-list-card.webp", 800, 1001),
      images: [pic("sales/meutuah-1978-price-list.webp", 1600, 2002, "Meutuah 1978 price list for Triple Pick specialty coffee: drip bags, ground and whole bean in 100 g, 250 g and 1 kg, and bundles, with the product line photographed on a wooden table")],
    },
  ],
  email: [
    {
      key: "mti-juz-amma", name: "Newsletter", client: "Measured Tones Institute", mail: true,
      title: { id: "Master the lessons of Juz ‘Amma", en: "Master the lessons of Juz ‘Amma" },
      card: pic("newsletter/mti-juz-amma-tafseer-card.webp", 680, 2048),
      images: [pic("newsletter/mti-juz-amma-tafseer.webp", 724, 2180, "Newsletter for Measured Tones Institute announcing The Last Chapter, a 10-month Juz ‘Amma tafseer course, with payment options and enrollment buttons")],
    },
    {
      // Source is only 528px wide, so the card and the full view share one file
      key: "mti-last-chapter", name: "Newsletter", client: "Measured Tones Institute", mail: true,
      title: { id: "Spots still available: The Last Chapter", en: "Spots still available: The Last Chapter" },
      card: pic("newsletter/mti-last-chapter.webp", 600, 1536),
      images: [pic("newsletter/mti-last-chapter.webp", 600, 1536, "Enrollment newsletter for Measured Tones Institute: spots still available in The Last Chapter, a 10-month Juz ‘Amma Mastery Course, with Full Experience and Tafseer Only options")],
    },
    {
      key: "mti-scholarship", name: "Newsletter", client: "Measured Tones Institute", mail: true,
      title: { id: "We’re just $2,000 away from our goal", en: "We’re just $2,000 away from our goal" },
      card: pic("newsletter/mti-scholarship-fund-card.webp", 680, 2528),
      images: [pic("newsletter/mti-scholarship-fund.webp", 1280, 4759, "Fundraising newsletter for the Measured Tones Institute scholarship fund: $8,000 of $10,000 raised, with a donate button and two course options")],
    },
  ],
};
// Rail order = the order of `works` (owner's pick: drip bag, box & pouch, the three jerseys,
// the logos, then the rest), each work one sheet, the open slot last.
const rail = [...Object.values(works).flat().map((w) => w.key), "open"];
const num = (key) => String(rail.indexOf(key) + 1).padStart(2, "0");

// Overview wall: every image of every work as a small tile, categories interleaved, dealt into
// three columns that drift up/down. Thumbs are <image>-thumb.webp, 480px wide (emails: their top, 4:5).
const catName = {
  sales: { id: "Promosi & penjualan", en: "Marketing & sales" },
  apparel: { id: "Kaos & jersey", en: "T-shirts & jerseys" },
  logo: { id: "Simple logo", en: "Simple logo" },
  email: { id: "Newsletter", en: "Newsletter" },
  packaging: { id: "Kemasan", en: "Packaging" },
};
const queues = Object.entries(works).map(([cat, list]) =>
  list.flatMap((w) => w.images.map((im) => ({
    key: w.key, cat, client: w.client, title: w.title.en,
    src: im.src.replace(/\.webp$/, "-thumb.webp"), w: 480, h: w.mail ? 600 : Math.round((480 * im.h) / im.w),
  }))));
const tiles = [];
while (queues.some((q) => q.length)) for (const q of queues) if (q.length) tiles.push(q.shift());
const wallCols = [0, 1, 2].map((c) => tiles.filter((_, i) => i % 3 === c));

const meta = {
  title: "Jasa Graphic Design untuk Bisnis & UMKM — Maul Digital",
  themeColor: "#fafbfc",
  description: "Desain konten sosial media, poster, flyer, menu, company profile, undangan, backdrop, jersey, newsletter, kemasan, dan simple logo. Revisi tanpa batas, bayar setelah sesuai brief.",
  canonical: "/products/graphic-design/",
  image: "/assets/brand/og/graphic-design.jpg",
  imageAlt: "Graphic Design oleh digmarketingmaul",
  structuredData: serviceGraph({
    name: "Graphic Design",
    path: "/products/graphic-design/",
    description: "Desain untuk konten digital, materi marketing, presentasi, cetak, merchandise, newsletter / email blast, kemasan produk, dan simple logo.",
    serviceType: "Graphic design",
    image: "/assets/brand/og/graphic-design.jpg",
    faq: faq.map((item) => ({ q: plain(item.id.q), a: item.id.a.map(plain).join(" ") })),
  }),
};
---
<!--
  Graphic Design product page — “Hanging Samples” (light only).
  Built on the Website Development page: its stylesheet is loaded first as the shared base
  (tokens, header, hanging rail, bento, steps, pricing, payment, FAQ, brief form, footer);
  src/styles/products/graphic-design.css only adds the design-specific parts.
  The hero sheets mix HTML/CSS sample applications with real client work (images, the `works`
  data above, one WorkSheet each) that opens full-size in the work viewer dialog.
  Script: src/scripts/products/graphic-design.js · notes: docs/graphic-design.md
-->
<BaseLayout meta={meta} lang="id" htmlAttributes={{"data-language": "id", "data-international": "false"}} bodyAttributes={{"data-page": "graphic-design"}}>
<Fragment slot="head">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
<link rel="stylesheet" href={baseCss} />
<link rel="stylesheet" href={pageCss} />
<script is:inline set:html={initScript}></script>
</Fragment>
  <a class="skip-link" href="#main"><span class="lang-id">Langsung ke konten</span><span class="lang-en">Skip to content</span></a>
  <div class="grain" aria-hidden="true"></div>
  <div class="cursor" aria-hidden="true">
    <span class="cursor-ring"><span class="cursor-label"></span></span>
    <span class="cursor-dot"></span>
  </div>

  <!-- ============ HEADER — same as Website Development ============ -->
  <header class="site-header" data-header>
    <div class="site-header-inner">
      <a href="/index.html#home" class="brand-logo" aria-label="M. Dimas Maulana Home"><img src="/assets/brand/logo/icon.svg" alt="digmarketingmaul" width="34" height="34"><span class="brand-word">digmarketingmaul</span></a>
      <div class="header-tools">
        <label class="lang-select">
          <span class="visually-hidden">Language</span>
          <select data-maul-language-select>
            <option value="id">ID</option>
            <option value="en">EN</option>
          </select>
        </label>
        <button class="intl-toggle" type="button" data-product-international-toggle aria-pressed="false" aria-label="International mode">
          <span class="intl-track" aria-hidden="true"><i></i></span><span>International</span>
        </button>
        <a class="btn btn-ink btn-sm header-cta" href="#contact" data-magnetic>Let's discuss</a>
      </div>
    </div>
    <div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
  </header>

  <main id="main">

    <!-- ============ HERO — headline beside the sample applications (hanging sheets) ============ -->
    <section class="hero hero--design" id="samples" aria-labelledby="design-title" data-view="wall">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <h1 class="hero-title" id="design-title" data-reveal-title>
            <span class="mask-line"><span>Graphic</span></span>
            <span class="mask-line"><span><em>design</em><span class="accent-dot">.</span></span></span>
          </h1>
          <p class="hero-lead reveal">Design for digital content, marketing materials, presentations, print, and more.</p>
          <div class="hero-work-ui reveal">
            <p class="hero-work-label"><span class="lang-id">Bisa dibuat</span><span class="lang-en">What we make</span><span class="accent-dot">.</span> <small><span class="lang-id">Klik untuk lihat karyanya</span><span class="lang-en">Click to see the work</span></small></p>
            <!-- Each button jumps the rail to the first sheet with the same data-cat -->
            <ol class="cats" aria-label="Graphic design categories">
              <li><button class="cat" type="button" data-cat-go="social"><span class="cat-num">01</span><span class="cat-name">Social media</span><span class="cat-items"><span class="lang-id">Post, story, banner, visual produk</span><span class="lang-en">Posts, stories, banners, product visuals</span></span><span class="cat-go" aria-hidden="true">→</span></button></li>
              <li><button class="cat" type="button" data-cat-go="sales"><span class="cat-num">02</span><span class="cat-name"><span class="lang-id">Promosi &amp; penjualan</span><span class="lang-en">Marketing &amp; sales</span></span><span class="cat-items"><span class="lang-id">Poster, flyer, price list, katalog, menu</span><span class="lang-en">Posters, flyers, price lists, catalogues, menus</span></span><span class="cat-go" aria-hidden="true">→</span></button></li>
              <li><button class="cat" type="button" data-cat-go="docs"><span class="cat-num">03</span><span class="cat-name"><span class="lang-id">Presentasi &amp; dokumen</span><span class="lang-en">Presentations &amp; documents</span></span><span class="cat-items"><span class="lang-id">Company profile, deck, proposal, booklet</span><span class="lang-en">Company profiles, decks, proposals, booklets</span></span><span class="cat-go" aria-hidden="true">→</span></button></li>
              <li><button class="cat" type="button" data-cat-go="print"><span class="cat-num">04</span><span class="cat-name"><span class="lang-id">Cetak &amp; event</span><span class="lang-en">Print &amp; events</span></span><span class="cat-items"><span class="lang-id">Undangan, backdrop, banner, booth, flyer cetak</span><span class="lang-en">Invitations, backdrops, banners, booths, printed flyers</span></span><span class="cat-go" aria-hidden="true">→</span></button></li>
              <li><button class="cat" type="button" data-cat-go="apparel"><span class="cat-num">05</span><span class="cat-name"><span class="lang-id">Kaos &amp; jersey</span><span class="lang-en">T-shirts &amp; jerseys</span></span><span class="cat-items"><span class="lang-id">Kaos, jersey olahraga, merchandise</span><span class="lang-en">T-shirts, sports jerseys, merchandise</span></span><span class="cat-go" aria-hidden="true">→</span></button></li>
              <li><button class="cat" type="button" data-cat-go="logo"><span class="cat-num">06</span><span class="cat-name">Simple logo</span><span class="cat-items"><span class="lang-id">Logo sederhana untuk UMKM</span><span class="lang-en">A simple logo for small businesses</span></span><span class="cat-go" aria-hidden="true">→</span></button></li>
              <li><button class="cat" type="button" data-cat-go="email"><span class="cat-num">07</span><span class="cat-name">Newsletter</span><span class="cat-items"><span class="lang-id">Email blast, newsletter, email promo</span><span class="lang-en">Email blasts, newsletters, promo emails</span></span><span class="cat-go" aria-hidden="true">→</span></button></li>
              <li><button class="cat" type="button" data-cat-go="packaging"><span class="cat-num">08</span><span class="cat-name"><span class="lang-id">Kemasan</span><span class="lang-en">Packaging</span></span><span class="cat-items"><span class="lang-id">Sachet, box, pouch, label produk</span><span class="lang-en">Sachets, boxes, pouches, product labels</span></span><span class="cat-go" aria-hidden="true">→</span></button></li>
            </ol>
            <div class="hang-ui">
              <p class="hang-label"><span class="hl-wall"><span class="lang-id">Semua karya</span><span class="lang-en">All work</span></span><span class="hl-rail"><span class="lang-id">Karya pilihan</span><span class="lang-en">Selected work</span></span></p>
              <button class="round-btn wall-btn" type="button" data-view-wall aria-label="Show all work"><i class="fa-solid fa-table-cells-large" aria-hidden="true"></i></button>
              <p class="hang-count"><b data-hang-current>01</b> / <span data-hang-total>{num("open")}</span></p>
              <button class="round-btn" type="button" data-hang-prev aria-label="Previous work"><span aria-hidden="true">←</span></button>
              <button class="round-btn" type="button" data-hang-next aria-label="Next work"><span aria-hidden="true">→</span></button>
            </div>
          </div>
        </div>

        <div class="hero-work">
        <!-- Overview wall: everything at once, small. A tile opens the rail (below) at that work. -->
        <div class="wall" data-wall role="region" aria-label="All work">
          <div class="wall-cols">
            {wallCols.map((col, c) => (
            <ul class="wall-col" style={`--dur:${[64, 78, 70][c]}s`} data-dir={c === 1 ? "down" : "up"}>
              {[...col, ...col].map((t, k) => (
              <li aria-hidden={k >= col.length ? "true" : undefined}>
                <button class="wall-tile" type="button" data-wall-go={t.key} data-cursor="View" tabindex={k >= col.length ? -1 : undefined} aria-label={`${t.client}: ${t.title}`}>
                  <img src={t.src} alt="" width={t.w} height={t.h} loading={k < col.length ? "eager" : "lazy"} decoding="async" draggable="false">
                  <span class="wall-cap"><b>{t.client}</b><small><span class="lang-id">{catName[t.cat].id}</span><span class="lang-en">{catName[t.cat].en}</span></small></span>
                </button>
              </li>
              ))}
            </ul>
            ))}
          </div>
        </div>

        <div class="hang hang--design" data-hang>
          <span class="hang-rail" aria-hidden="true"></span>
          <div class="hang-viewport" data-hang-viewport tabindex="0" role="region" aria-roledescription="carousel" aria-label="Selected work — drag, or use the arrow keys">
            <ol class="hang-track" data-hang-track>
              <!--
                Real client work only, one WorkSheet per entry of `works`, in that order.
                Numbers come from `rail` in the frontmatter.
              -->

              {Object.entries(works).flatMap(([cat, list]) => list.map((w) => <WorkSheet work={w} idx={num(w.key)} cat={cat} />))}

              <!-- The open slot: always last -->
              <li class="sheet sheet--next" style="--tone:#ff304f">
                <div class="sheet-swing">
                  <span class="sheet-string" aria-hidden="true"></span><span class="sheet-clip" aria-hidden="true"></span>
                  <div class="sheet-paper" data-cursor="Drag">
                    <span class="sheet-screen sheet-screen--next">
                      <span class="next-plus" aria-hidden="true">+</span>
                      <span class="next-title">Your design<br>is next<span class="accent-dot">.</span></span>
                    </span>
