---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { serviceGraph } from '../../../data/structured-data.js';
import initScript from '../../../scripts/products/product-page-init.js?raw';
import baseCss from '../../../styles/products/website-development.css?url';
import pageCss from '../../../styles/products/video-editing-motion.css?url';
import pageJs from '../../../scripts/products/video-editing-motion.js?url';
// One source for the visible FAQ and its JSON-LD. Answers may hold inline HTML (links).
const plain = (html) => html.replace(/<[^>]+>/g, "").replace(/&amp;/g, "&").trim();
const faq = [
  {
    "id": {
      "q": "Bisa pakai footage dari saya?",
      "a": [
        "Bisa. Kirim footage, foto, logo, atau aset yang kamu punya.",
        "Belum punya footage? Video bisa dibangun sepenuhnya dengan motion graphics."
      ]
    },
    "en": {
      "q": "Can you work with my footage?",
      "a": [
        "Yes. Send the footage, photos, logo or any assets you have.",
        "No footage yet? The video can be built entirely with motion graphics."
      ]
    }
  },
  {
    "id": {
      "q": "Untuk platform apa saja?",
      "a": [
        "Instagram Reels, TikTok, YouTube Shorts, iklan digital, YouTube, website, sampai presentasi.",
        "Satu video bisa disiapkan dalam beberapa rasio: 9:16, 4:5, 1:1, atau 16:9."
      ]
    },
    "en": {
      "q": "Which platforms?",
      "a": [
        "Instagram Reels, TikTok, YouTube Shorts, digital ads, YouTube, websites and presentations.",
        "One video can be delivered in several ratios: 9:16, 4:5, 1:1 or 16:9."
      ]
    }
  },
  {
    "id": {
      "q": "Berapa lama pengerjaannya?",
      "a": [
        "Tergantung durasi dan tingkat kerumitannya. Estimasi waktu disampaikan setelah brief."
      ]
    },
    "en": {
      "q": "How long does it take?",
      "a": [
        "It depends on the length and complexity. You get a time estimate after the brief."
      ]
    }
  },
  {
    "id": {
      "q": "Termasuk musik, subtitle, dan voice over?",
      "a": [
        "Bisa, sesuai kebutuhan. Sumber musik dan voice over kita sepakati bersama, termasuk lisensinya."
      ]
    },
    "en": {
      "q": "Music, subtitles and voice-over included?",
      "a": [
        "Yes, as needed. We agree on the music and voice-over sources together, licences included."
      ]
    }
  },
  {
    "id": {
      "q": "Bagaimana dengan revisi?",
      "a": [
        "Revisi sesuai yang kamu mau, jumlahnya tidak dibatasi. Kamu bayar hanya setelah videonya sesuai dengan brief yang kamu sampaikan."
      ]
    },
    "en": {
      "q": "What about revisions?",
      "a": [
        "Ask for as many revisions as you need. You only pay once the video matches the brief you gave."
      ]
    }
  },
  {
    "id": {
      "q": "Pembeli dari luar Indonesia?",
      "a": [
        "Bisa. Bayar dengan PayPal, Visa, Mastercard, atau metode internasional lain."
      ]
    },
    "en": {
      "q": "Buying from outside Indonesia?",
      "a": [
        "Yes. Pay with PayPal, Visa, Mastercard or other international methods."
      ]
    }
  },
  {
    "id": {
      "q": "Bisa sekalian dibuatkan website?",
      "a": [
        "Bisa. Lihat <a href=\"/products/website-development/\">Website Development</a>."
      ]
    },
    "en": {
      "q": "Can you build the website too?",
      "a": [
        "Yes. See <a href=\"/products/website-development/\">Website Development</a>."
      ]
    }
  }
];
const meta = {
  title: "Jasa Video Editing & Motion Graphics — Maul Digital",
  themeColor: "#fafbfc",
  description: "Jasa video editing, motion graphics, dan video promo untuk Reels, TikTok, YouTube, dan iklan digital. Revisi tanpa batas, bayar setelah sesuai brief.",
  canonical: "/products/video-editing-motion/",
  image: "/assets/brand/og/video-editing-motion.jpg",
  imageAlt: "Video Editing & Motion oleh digmarketingmaul",
  structuredData: serviceGraph({
    name: "Video Editing & Motion",
    path: "/products/video-editing-motion/",
    description: "Produksi video, video editing, motion graphics, dan video promo untuk bisnis maupun brand.",
    serviceType: "Video editing and motion graphics",
    image: "/assets/brand/og/video-editing-motion.jpg",
    faq: faq.map((item) => ({ q: plain(item.id.q), a: item.id.a.map(plain).join(" ") })),
  }),
};
---
<!--
  Video Editing & Motion product page — “Hanging Reels” (light only).
  Built on the Website Development page: its stylesheet is loaded first as the shared base
  (tokens, header, hanging rail, bento, steps, pricing, payment, FAQ, brief form, footer);
  src/styles/products/video-editing-motion.css only adds the video-specific parts.
  Script: src/scripts/products/video-editing-motion.js · notes: docs/video-editing-motion.md
  Videos: assets/video-editing-motion/work/ (regenerate with scripts/prepare-video-assets.mjs)
-->
<BaseLayout meta={meta} lang="id" htmlAttributes={{"data-language": "id", "data-international": "false"}} bodyAttributes={{"data-page": "video-editing-motion"}}>
<Fragment slot="head">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
<link rel="stylesheet" href={baseCss} />
<link rel="stylesheet" href={pageCss} />
<script is:inline set:html={initScript}></script>
</Fragment>
  <a class="skip-link" href="#main"><span class="lang-id">Langsung ke konten</span><span class="lang-en">Skip to content</span></a>
  <div class="grain" aria-hidden="true"></div>
  <div class="cursor" aria-hidden="true">
    <span class="cursor-ring"><span class="cursor-label"></span></span>
    <span class="cursor-dot"></span>
  </div>

  <!-- ============ HEADER — same as Website Development ============ -->
  <header class="site-header" data-header>
    <div class="site-header-inner">
      <a href="/index.html#home" class="brand-logo" aria-label="M. Dimas Maulana Home"><img src="/assets/brand/logo/icon.svg" alt="digmarketingmaul" width="34" height="34"><span class="brand-word">digmarketingmaul</span></a>
      <div class="header-tools">
        <label class="lang-select">
          <span class="visually-hidden">Language</span>
          <select data-maul-language-select>
            <option value="id">ID</option>
            <option value="en">EN</option>
          </select>
        </label>
        <button class="intl-toggle" type="button" data-product-international-toggle aria-pressed="false" aria-label="International mode">
          <span class="intl-track" aria-hidden="true"><i></i></span><span>International</span>
        </button>
        <a class="btn btn-ink btn-sm header-cta" href="#contact" data-magnetic>Let's discuss</a>
      </div>
    </div>
    <div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
  </header>

  <main id="main">

    <!-- ============ HERO — headline beside the selected work (hanging reels) ============ -->
    <section class="hero hero--reels" id="work" aria-labelledby="work-title">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <h1 class="hero-title" id="work-title" data-reveal-title>
            <span class="mask-line"><span>Video</span></span>
            <span class="mask-line"><span>editing &amp;</span></span>
            <span class="mask-line"><span><em>motion</em><span class="accent-dot">.</span></span></span>
          </h1>
          <p class="hero-lead reveal"><span class="lang-id">Produksi video, editing, dan motion graphics oleh Maul.</span><span class="lang-en">Video production, editing and motion graphics by Maul.</span></p>
          <div class="hero-work-ui reveal">
            <p class="hero-work-label">Selected work, crafted by Maul<span class="accent-dot">.</span></p>
            <div class="hang-ui">
              <p class="hang-count"><b data-hang-current>01</b> / <span data-hang-total>03</span></p>
              <button class="round-btn" type="button" data-hang-prev aria-label="Previous video"><span aria-hidden="true">←</span></button>
              <button class="round-btn" type="button" data-hang-next aria-label="Next video"><span aria-hidden="true">→</span></button>
            </div>
          </div>
        </div>

        <div class="hero-work">
        <div class="hang hang--reels" data-hang>
          <span class="hang-rail" aria-hidden="true"></span>
          <div class="hang-viewport" data-hang-viewport tabindex="0" role="region" aria-roledescription="carousel" aria-label="Selected work — drag, or use the arrow keys">
            <ol class="hang-track" data-hang-track>
              <!--
                Add a video: copy one <li class="sheet">, set --tone, the poster <img>, the preview
                <video data-src>, data-full (the version with sound), the time chip, name and type.
                Files come from scripts/prepare-video-assets.mjs.
              -->
              <li class="sheet" style="--tone:#0a1f3a" data-full="/assets/video-editing-motion/work/hijra-deposito-10.mp4">
                <div class="sheet-swing">
                  <span class="sheet-string" aria-hidden="true"></span><span class="sheet-clip" aria-hidden="true"></span>
                  <div class="sheet-paper" data-cursor="Drag">
                    <button class="sheet-screen" type="button" tabindex="-1" data-play data-cursor="Play" aria-label="Play Hijra Bank video">
                      <img src="/assets/video-editing-motion/work/hijra-deposito-10-poster.webp" alt="Hijra Bank — Deposito promo video" width="540" height="960" draggable="false">
                      <video data-src="/assets/video-editing-motion/work/hijra-deposito-10-preview.mp4" muted loop playsinline preload="none" disablepictureinpicture tabindex="-1" aria-hidden="true"></video>
                      <span class="sheet-time" aria-hidden="true">0:28</span>
                      <span class="sheet-play" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg></span>
                    </button>
                    <span class="sheet-caption">
                      <span class="sheet-idx">01</span>
                      <span class="sheet-name"><strong>Hijra Bank</strong><small>Banking · Promo motion</small></span>
                      <button class="sheet-go sheet-go--play" type="button" data-play data-cursor="Play" aria-label="Play Hijra Bank video with sound"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg></button>
                    </span>
                  </div>
                </div>
              </li>
              <li class="sheet" style="--tone:#0b0f1a" data-full="/assets/video-editing-motion/work/digmarketingmaul-website-offer.mp4">
                <div class="sheet-swing">
                  <span class="sheet-string" aria-hidden="true"></span><span class="sheet-clip" aria-hidden="true"></span>
                  <div class="sheet-paper" data-cursor="Drag">
                    <button class="sheet-screen" type="button" tabindex="-1" data-play data-cursor="Play" aria-label="Play digmarketingmaul video">
                      <img src="/assets/video-editing-motion/work/digmarketingmaul-website-offer-poster.webp" alt="digmarketingmaul — Website Development offer video" width="540" height="960" draggable="false">
                      <video data-src="/assets/video-editing-motion/work/digmarketingmaul-website-offer-preview.mp4" muted loop playsinline preload="none" disablepictureinpicture tabindex="-1" aria-hidden="true"></video>
                      <span class="sheet-time" aria-hidden="true">0:39</span>
                      <span class="sheet-play" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg></span>
                    </button>
                    <span class="sheet-caption">
                      <span class="sheet-idx">02</span>
                      <span class="sheet-name"><strong>digmarketingmaul</strong><small>Website offer · Motion ad</small></span>
                      <button class="sheet-go sheet-go--play" type="button" data-play data-cursor="Play" aria-label="Play digmarketingmaul video with sound"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg></button>
                    </span>
                  </div>
                </div>
              </li>
              <!-- The open slot: always last -->
              <li class="sheet sheet--next" style="--tone:#ff304f">
                <div class="sheet-swing">
                  <span class="sheet-string" aria-hidden="true"></span><span class="sheet-clip" aria-hidden="true"></span>
                  <div class="sheet-paper" data-cursor="Drag">
                    <span class="sheet-screen sheet-screen--next">
                      <span class="next-plus" aria-hidden="true">+</span>
                      <span class="next-title">Your video<br>is next<span class="accent-dot">.</span></span>
                    </span>
                    <span class="sheet-caption">
                      <span class="sheet-idx">03</span>
                      <span class="sheet-name"><strong><span class="lang-id">Slot terbuka</span><span class="lang-en">Open slot</span></strong><small><span class="lang-id">Mulai dari brief singkat</span><span class="lang-en">Starts with a quick brief</span></small></span>
                      <a class="sheet-go sheet-go--red" href="#contact" data-cursor="Let's talk" aria-label="Let's discuss your video">→</a>
                    </span>
                  </div>
                </div>
              </li>
            </ol>
          </div>
          <div class="hang-foot">
            <span class="hang-progress" aria-hidden="true"><i data-hang-bar></i></span>
            <span class="hang-hint" aria-hidden="true"><span class="lang-id">Geser</span><span class="lang-en">Drag</span> ↔</span>
          </div>
        </div>
        </div>
      </div>
    </section>

    <!-- ============ WHAT WE MAKE — scope bento ============ -->
    <section class="why" id="scope" aria-labelledby="scope-title">
      <div class="shell">
        <h2 class="section-title" id="scope-title" data-reveal-title>
          <span class="mask-line"><span>What we make<span class="accent-dot">.</span></span></span>
        </h2>

        <div class="bento">
          <a class="tile tile--wide tile--red reveal" href="#contact" data-spot data-cursor="Let's talk">
            <div class="viz viz-start" aria-hidden="true">
              <span class="vs-inputs"><i>Footage</i><i><span class="lang-id">Foto</span><span class="lang-en">Photos</span></i><i>Logo</i><i><span class="lang-id">Ide</span><span class="lang-en">Idea</span></i></span>
              <span class="vs-arrow"></span>
              <span class="vs-frame"><span class="vs-play"></span><span class="vs-bar"><i></i></span></span>
            </div>
            <h3><span class="lang-id">Mulai dari apa saja.</span><span class="lang-en">Start from anything.</span></h3>
            <p class="tile-line"><span class="lang-id">Footage mentah, foto, logo, atau baru sebatas ide.</span><span class="lang-en">Raw footage, photos, a logo, or just an idea.</span></p>
            <span class="tile-go" aria-hidden="true">→</span>
          </a>
          <article class="tile reveal" data-spot>
            <div class="viz viz-edit" aria-hidden="true">
              <span class="ve-track"><i style="--x:0;--w:.34"></i><i style="--x:.37;--w:.22"></i><i style="--x:.62;--w:.38"></i></span>
              <span class="ve-track"><i style="--x:.08;--w:.5"></i><i style="--x:.62;--w:.24"></i></span>
              <span class="ve-track ve-track--audio"><i style="--x:0;--w:1"></i></span>
              <span class="ve-head"></span>
            </div>
            <h3>Video editing<span class="accent-dot">.</span></h3>
            <p class="tile-line"><span class="lang-id">Footage dipotong, disusun, dan dirapikan sampai siap tayang.</span><span class="lang-en">Footage cut, arranged and polished until it's ready to post.</span></p>
          </article>
          <article class="tile reveal" data-spot>
            <div class="viz viz-motion" aria-hidden="true">
              <span class="vm-stage"><i class="vm-dot"></i><i class="vm-box"></i><b class="vm-type">Aa</b></span>
            </div>
            <h3>Motion graphics<span class="accent-dot">.</span></h3>
            <p class="tile-line"><span class="lang-id">Teks, ikon, dan visual yang bergerak.</span><span class="lang-en">Type, icons and visuals in motion.</span></p>
          </article>
          <article class="tile reveal" data-spot>
            <div class="viz viz-ratio" aria-hidden="true"><i class="vr-916">9:16</i><i class="vr-45">4:5</i><i class="vr-11">1:1</i><i class="vr-169">16:9</i></div>
            <h3><span class="lang-id">Promo &amp; iklan.</span><span class="lang-en">Promos &amp; ads.</span></h3>
            <p class="tile-line"><span class="lang-id">Untuk Reels, TikTok, Shorts, dan iklan digital.</span><span class="lang-en">For Reels, TikTok, Shorts and digital ads.</span></p>
          </article>
          <article class="tile reveal" data-spot>
            <div class="viz viz-audio" aria-hidden="true">
              <span class="va-wave"><i style="--d:0"></i><i style="--d:.1"></i><i style="--d:.2"></i><i style="--d:.3"></i><i style="--d:.4"></i><i style="--d:.5"></i><i style="--d:.6"></i><i style="--d:.7"></i><i style="--d:.8"></i><i style="--d:.9"></i><i style="--d:1"></i><i style="--d:1.1"></i><i style="--d:1.2"></i><i style="--d:1.3"></i></span>
              <span class="va-sub"><span class="lang-id">Subtitle di sini.</span><span class="lang-en">Subtitles here.</span></span>
            </div>
            <h3><span class="lang-id">Audio &amp; subtitle.</span><span class="lang-en">Audio &amp; subtitles.</span></h3>
            <p class="tile-line"><span class="lang-id">Musik, SFX, voice over, dan subtitle.</span><span class="lang-en">Music, SFX, voice-over and subtitles.</span></p>
          </article>
        </div>
      </div>
    </section>

    <!-- ============ HOW IT WORKS ============ -->
    <section class="process" id="process" aria-labelledby="process-title" data-process>
      <div class="shell">
        <h2 class="section-title" id="process-title" data-reveal-title>
          <span class="mask-line"><span>How it works<span class="accent-dot">.</span></span></span>
        </h2>
        <ol class="steps">
          <li class="step"><span class="step-num">01</span><strong>Brief</strong><span><span class="lang-id">Ceritakan kebutuhanmu</span><span class="lang-en">Tell us what you need</span></span></li>
          <li class="step"><span class="step-num">02</span><strong><span class="lang-id">Konsep</span><span class="lang-en">Concept</span></strong><span><span class="lang-id">Arah visual &amp; alur video</span><span class="lang-en">Visual direction &amp; flow</span></span></li>
          <li class="step"><span class="step-num">03</span><strong><span class="lang-id">Produksi</span><span class="lang-en">Production</span></strong><span>Editing &amp; motion</span></li>
          <li class="step"><span class="step-num">04</span><strong>Review</strong><span><span class="lang-id">Revisi sampai sesuai brief</span><span class="lang-en">Revised until it matches your brief</span></span></li>
          <li class="step"><span class="step-num">05</span><strong>Delivery</strong><span><span class="lang-id">Bayar, terima file final</span><span class="lang-en">Pay, get the final files</span></span></li>
        </ol>
      </div>
    </section>

    <!-- ============ PRICING + ACCEPT PAYMENT ============ -->
    <section class="pricing" id="pricing" aria-labelledby="pricing-title">
      <div class="shell">
        <h2 class="section-title" id="pricing-title" data-reveal-title>
          <span class="mask-line"><span>Pricing<span class="accent-dot">.</span></span></span>
        </h2>

        <div class="plans">
          <article class="plan plan--main reveal" data-spot>
            <p class="plan-label">Video &amp; Motion</p>
            <p class="plan-price"><strong class="plan-price-text"><span class="lang-id">Sesuai scope</span><span class="lang-en">By scope</span></strong></p>
            <ul class="plan-list">
              <li><span class="lang-id">Harga disepakati sebelum mulai</span><span class="lang-en">Price agreed before we start</span></li>
              <li><span class="lang-id">Dihitung dari durasi, format &amp; jumlah video</span><span class="lang-en">Based on length, format &amp; number of videos</span></li>
              <li><span class="lang-id">Revisi tanpa batas, bayar setelah sesuai brief</span><span class="lang-en">Unlimited revisions, pay once it matches the brief</span></li>
              <li><span class="lang-id">Satu video atau satu seri</span><span class="lang-en">One video or a whole series</span></li>
            </ul>
            <a class="btn btn-red btn-lg btn-block" href="#contact" data-magnetic>
              <span class="lang-id">Diskusikan Scope</span><span class="lang-en">Discuss the scope</span>
              <span class="btn-arrow" aria-hidden="true">→</span>
            </a>
          </article>
          <article class="plan plan--custom reveal" data-spot>
            <p class="plan-label"><span class="lang-id">Lainnya</span><span class="lang-en">Other</span></p>
            <p class="plan-price"><strong class="plan-price-text"><span class="lang-id">Butuh yang lain?</span><span class="lang-en">Something else?</span></strong></p>
            <ul class="plan-list">
              <li><span class="lang-id">Animasi logo</span><span class="lang-en">Logo animation</span></li>
              <li><span class="lang-id">Video explainer &amp; presentasi</span><span class="lang-en">Explainers &amp; presentations</span></li>
              <li><span class="lang-id">Motion untuk website</span><span class="lang-en">Motion for websites</span></li>
              <li><span class="lang-id">Kebutuhan visual motion lainnya</span><span class="lang-en">Other motion visuals</span></li>
            </ul>
            <a class="btn btn-ghost btn-lg btn-block" href="#contact">Let's discuss <span class="btn-arrow" aria-hidden="true">→</span></a>
          </article>
        </div>

        <div class="pay reveal">
          <p class="pay-title">Accept payment</p>
          <div class="pay-group">
            <p class="pay-label">Indonesia</p>
            <ul class="pay-logos">
              <li class="qris">
                <button class="qris-btn" type="button" aria-expanded="false" aria-controls="qris-pop" data-qris>
                  <img src="/assets/payment-methods/qris.webp" alt="QRIS">
                  <span class="qris-badge"><span class="lang-id">Lihat</span><span class="lang-en">View</span></span>
                </button>
                <div class="qris-pop" id="qris-pop" role="dialog" aria-label="QRIS digmarketingmaul" data-qris-pop>
                  <img src="/assets/payment-methods/qris-digmarketingmaul.webp" alt="QRIS Digital Marketing Maul, NMID ID1026603703558" width="760" height="1071" loading="lazy">
                  <p class="qris-warn"><strong><span class="lang-id">Konfirmasi dulu, baru bayar.</span><span class="lang-en">Confirm first, then pay.</span></strong> <span class="lang-id">Bayar tanpa konfirmasi =&nbsp;sedekah.</span><span class="lang-en">Paying without confirming =&nbsp;a&nbsp;donation.</span></p>
                  <a class="qris-confirm" href="#contact"><span class="lang-id">Konfirmasi via WhatsApp</span><span class="lang-en">Confirm on WhatsApp</span> →</a>
                </div>
              </li>
              <li><img src="/assets/payment-methods/hijra.webp" alt="Hijra Bank" loading="lazy"></li>
              <li><img src="/assets/payment-methods/gopay.webp" alt="GoPay" loading="lazy"></li>
              <li><img src="/assets/payment-methods/shopeepay.webp" alt="ShopeePay" loading="lazy"></li>
              <li><img src="/assets/payment-methods/dana.webp" alt="DANA" loading="lazy"></li>
              <li><img src="/assets/payment-methods/ovo.webp" alt="OVO" loading="lazy"></li>
              <li><img src="/assets/payment-methods/permata.webp" alt="PermataBank" loading="lazy"></li>
              <li><img src="/assets/payment-methods/bsi.webp" alt="Bank Syariah Indonesia" loading="lazy"></li>
              <li><img src="/assets/payment-methods/mandiri.webp" alt="Bank Mandiri" loading="lazy"></li>
              <li><img src="/assets/payment-methods/bri.webp" alt="BRI" loading="lazy"></li>
              <li><img src="/assets/payment-methods/bni.webp" alt="BNI" loading="lazy"></li>
              <li><img src="/assets/payment-methods/btn.webp" alt="BTN" loading="lazy"></li>
              <li><img src="/assets/payment-methods/cimb.webp" alt="CIMB Niaga" loading="lazy"></li>
              <li><img src="/assets/payment-methods/danamon.webp" alt="Danamon" loading="lazy"></li>
              <li><img src="/assets/payment-methods/maybank.webp" alt="Maybank" loading="lazy"></li>
              <li><img src="/assets/payment-methods/bjb.webp" alt="bank bjb" loading="lazy"></li>
              <li><img src="/assets/payment-methods/sinarmas.webp" alt="Bank Sinarmas" loading="lazy"></li>
              <li><img src="/assets/payment-methods/bnc.webp" alt="Bank Neo Commerce" loading="lazy"></li>
              <li><img src="/assets/payment-methods/bss.webp" alt="Bank Sahabat Sampoerna" loading="lazy"></li>
              <li><img src="/assets/payment-methods/seabank.webp" alt="SeaBank" loading="lazy"></li>
              <li><img src="/assets/payment-methods/alfa.webp" alt="Alfamart" loading="lazy"></li>
              <li><img src="/assets/payment-methods/indomaret.webp" alt="Indomaret" loading="lazy"></li>
            </ul>
          </div>
          <div class="pay-group">
            <p class="pay-label">International</p>
            <ul class="pay-logos">
              <li><img src="/assets/payment-methods/paypal.svg" alt="PayPal" loading="lazy"></li>
              <li><img src="/assets/payment-methods/visa.webp" alt="Visa" loading="lazy"></li>
              <li><img src="/assets/payment-methods/mastercard.webp" alt="Mastercard" loading="lazy"></li>
              <li><img src="/assets/payment-methods/jcb.webp" alt="JCB" loading="lazy"></li>
              <li><img src="/assets/payment-methods/amex.svg" alt="American Express" loading="lazy"></li>
              <li><img src="/assets/payment-methods/unionpay.svg" alt="UnionPay" loading="lazy"></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ FAQ ============ -->
    <section class="faq" id="faq" aria-labelledby="faq-title">
      <div class="shell">
        <h2 class="section-title" id="faq-title" data-reveal-title>
          <span class="mask-line"><span>FAQ<span class="accent-dot">.</span></span></span>
        </h2>
        <div class="faq-list">
          {faq.map((item) => (
            <details class="reveal">
              <summary><span class="lang-id" set:html={item.id.q} /><span class="lang-en" set:html={item.en.q} /></summary>
              <div class="faq-a">
                {item.id.a.map((answer, i) => <p><span class="lang-id" set:html={answer} /><span class="lang-en" set:html={item.en.a[i]} /></p>)}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ CONTACT — brief form → WhatsApp (prefilled) ============ -->
    <section class="contact" id="contact" aria-labelledby="final-title">
      <div class="shell contact-grid">
        <div class="contact-intro">
          <h2 class="section-title" id="final-title" data-reveal-title>
            <span class="mask-line"><span>Let's discuss</span></span>
            <span class="mask-line"><span>your <em>video</em><span class="accent-dot">.</span></span></span>
          </h2>
          <p class="contact-lead"><span class="lang-id">Isi singkat, lanjut ke WhatsApp.</span><span class="lang-en">A quick brief, then WhatsApp.</span></p>

          <div class="chat" aria-hidden="true">
            <div class="chat-head">
              <span class="chat-avatar"><img src="/assets/brand/logo/icon.svg" alt="" width="26" height="26"></span>
              <span><strong>Maul</strong><small><span class="lang-id">Pratinjau pesan kamu</span><span class="lang-en">Your message preview</span></small></span>
            </div>
            <div class="chat-body">
              <p class="chat-bubble"><span data-chat-text></span><small><span class="lang-id">Belum terkirim</span><span class="lang-en">Not sent yet</span></small></p>
            </div>
          </div>
        </div>

        <form class="brief" data-brief novalidate>
          <div class="brief-head">
            <p class="brief-title"><span class="lang-id">Brief video</span><span class="lang-en">Video brief</span></p>
            <span class="brief-chip"><span class="lang-id">± 1 menit</span><span class="lang-en">± 1 minute</span></span>
          </div>

          <div class="field" data-field="name">
            <label for="f-name"><span class="lang-id">Nama kamu</span><span class="lang-en">Your name</span> <b>*</b></label>
            <input id="f-name" name="name" autocomplete="name" required data-ph-id="Nama panggilan" data-ph-en="What should we call you?">
            <p class="field-error"><span class="lang-id">Isi nama dulu, ya.</span><span class="lang-en">Please add your name.</span></p>
          </div>

          <div class="field">
            <label for="f-brand"><span class="lang-id">Bisnis / brand</span><span class="lang-en">Business / brand</span></label>
            <input id="f-brand" name="brand" autocomplete="organization" data-ph-id="Contoh: Kopi Senja" data-ph-en="e.g. Senja Coffee">
          </div>

          <fieldset class="field" data-field="need">
            <legend><span class="lang-id">Kamu butuh</span><span class="lang-en">You need</span> <b>*</b> <small class="legend-hint"><span class="lang-id">boleh lebih dari satu</span><span class="lang-en">pick any</span></small></legend>
            <div class="chips">
              <label class="chip"><input type="checkbox" name="need" value="editing" data-id="Video editing" data-en="Video editing"><span>Video editing</span></label>
              <label class="chip"><input type="checkbox" name="need" value="motion" data-id="Motion graphics" data-en="Motion graphics"><span>Motion graphics</span></label>
              <label class="chip"><input type="checkbox" name="need" value="promo" data-id="Video promo / iklan" data-en="Promo / ad video"><span><span class="lang-id">Video promo / iklan</span><span class="lang-en">Promo / ad video</span></span></label>
              <label class="chip"><input type="checkbox" name="need" value="logo" data-id="Animasi logo" data-en="Logo animation"><span><span class="lang-id">Animasi logo</span><span class="lang-en">Logo animation</span></span></label>
              <label class="chip"><input type="checkbox" name="need" value="other" data-id="Lainnya" data-en="Something else"><span><span class="lang-id">Lainnya</span><span class="lang-en">Other</span></span></label>
            </div>
            <p class="field-error"><span class="lang-id">Pilih minimal satu.</span><span class="lang-en">Pick at least one.</span></p>
          </fieldset>

          <fieldset class="field">
            <legend><span class="lang-id">Dipakai di</span><span class="lang-en">Where it will run</span></legend>
            <div class="chips">
              <label class="chip"><input type="checkbox" name="where" value="Instagram" data-id="Instagram" data-en="Instagram"><span>Instagram</span></label>
              <label class="chip"><input type="checkbox" name="where" value="TikTok" data-id="TikTok" data-en="TikTok"><span>TikTok</span></label>
              <label class="chip"><input type="checkbox" name="where" value="YouTube" data-id="YouTube" data-en="YouTube"><span>YouTube</span></label>
              <label class="chip"><input type="checkbox" name="where" value="Ads" data-id="Iklan digital" data-en="Digital ads"><span><span class="lang-id">Iklan</span><span class="lang-en">Ads</span></span></label>
              <label class="chip"><input type="checkbox" name="where" value="Website" data-id="Website" data-en="Website"><span>Website</span></label>
            </div>
          </fieldset>

          <div class="field-row">
            <div class="field">
              <label for="f-length"><span class="lang-id">Durasi video</span><span class="lang-en">Video length</span></label>
              <select id="f-length" name="length">
                <option value="" data-id="Pilih" data-en="Choose">Pilih</option>
                <option value="15" data-id="Di bawah 15 detik" data-en="Under 15 seconds">Di bawah 15 detik</option>
                <option value="30" data-id="15–30 detik" data-en="15–30 seconds">15–30 detik</option>
                <option value="60" data-id="30–60 detik" data-en="30–60 seconds">30–60 detik</option>
                <option value="long" data-id="Lebih dari 1 menit" data-en="Over a minute">Lebih dari 1 menit</option>
                <option value="unsure" data-id="Belum tahu" data-en="Not sure yet">Belum tahu</option>
              </select>
            </div>
            <div class="field">
              <label for="f-when"><span class="lang-id">Target selesai</span><span class="lang-en">Deadline</span></label>
              <select id="f-when" name="when">
                <option value="" data-id="Pilih" data-en="Choose">Pilih</option>
                <option value="asap" data-id="Secepatnya" data-en="As soon as possible">Secepatnya</option>
                <option value="2w" data-id="Kurang dari 2 minggu" data-en="Within two weeks">Kurang dari 2 minggu</option>
                <option value="1m" data-id="Kurang dari 1 bulan" data-en="Within a month">Kurang dari 1 bulan</option>
                <option value="unsure" data-id="Belum tahu" data-en="Not sure yet">Belum tahu</option>
              </select>
            </div>
          </div>

          <div class="field">
            <label for="f-ref"><span class="lang-id">Referensi video</span><span class="lang-en">Reference video</span></label>
            <input id="f-ref" name="ref" data-ph-id="Link atau nama akun (opsional)" data-ph-en="A link or an account (optional)">
          </div>

          <div class="field">
            <label for="f-note"><span class="lang-id">Ceritakan idemu</span><span class="lang-en">Tell us your idea</span></label>
            <textarea id="f-note" name="note" rows="3" data-ph-id="Tujuan video, gaya, materi yang sudah ada, atau apa pun di kepalamu" data-ph-en="The goal, style, material you already have, anything on your mind"></textarea>
          </div>

          <button class="btn btn-red btn-lg btn-block" type="submit">
            <svg class="wa-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.3 7.4L3 21l2.1-5.6A8.4 8.4 0 1 1 21 11.5z"/></svg>
            <span class="lang-id">Lanjutkan ke WhatsApp</span><span class="lang-en">Continue on WhatsApp</span>
          </button>
          <p class="brief-note"><span class="lang-id">Pesan terbuka di WhatsApp. Data formulir tidak disimpan.</span><span class="lang-en">Your message opens in WhatsApp. Nothing is stored.</span></p>
        </form>
      </div>
    </section>
  </main>

  <!-- ============ PLAYER — full video with sound; the file loads only when opened ============ -->
  <dialog class="player" data-player aria-labelledby="player-title">
    <div class="player-inner">
      <div class="player-frame">
        <video controls playsinline preload="none" data-player-video></video>
      </div>
      <div class="player-caption">
        <span class="sheet-idx" data-player-idx>01</span>
        <span class="sheet-name"><strong id="player-title" data-player-title></strong><small data-player-meta></small></span>
        <button class="player-close" type="button" data-player-close aria-label="Close video"><span aria-hidden="true">✕</span></button>
      </div>
    </div>
  </dialog>

  <!-- ============ FOOTER — same as the other pages (BrandFooter), light ============ -->
