          <div class="brief-head">
            <p class="brief-title"><span class="lang-id">Brief desain</span><span class="lang-en">Design brief</span></p>
            <span class="brief-chip"><span class="lang-id">± 1 menit</span><span class="lang-en">± 1 minute</span></span>
          </div>

          <div class="field" data-field="name">
            <label for="f-name"><span class="lang-id">Nama kamu</span><span class="lang-en">Your name</span> <b>*</b></label>
            <input id="f-name" name="name" autocomplete="name" required data-ph-id="Nama panggilan" data-ph-en="What should we call you?">
            <p class="field-error"><span class="lang-id">Isi nama dulu, ya.</span><span class="lang-en">Please add your name.</span></p>
          </div>

          <div class="field">
            <label for="f-brand"><span class="lang-id">Bisnis / brand</span><span class="lang-en">Business / brand</span></label>
            <input id="f-brand" name="brand" autocomplete="organization" data-ph-id="Contoh: Kopi Senja" data-ph-en="e.g. Senja Coffee">
          </div>

          <fieldset class="field" data-field="need">
            <legend><span class="lang-id">Kamu butuh</span><span class="lang-en">You need</span> <b>*</b> <small class="legend-hint"><span class="lang-id">boleh lebih dari satu</span><span class="lang-en">pick any</span></small></legend>
            <div class="chips">
              <label class="chip"><input type="checkbox" name="need" value="social" data-id="Social media" data-en="Social media"><span>Social media</span></label>
              <label class="chip"><input type="checkbox" name="need" value="poster" data-id="Poster / flyer" data-en="Poster / flyer"><span>Poster / flyer</span></label>
              <label class="chip"><input type="checkbox" name="need" value="deck" data-id="Presentasi / company profile" data-en="Presentation / company profile"><span><span class="lang-id">Presentasi / company profile</span><span class="lang-en">Deck / company profile</span></span></label>
              <label class="chip"><input type="checkbox" name="need" value="menu" data-id="Menu / katalog / price list" data-en="Menu / catalogue / price list"><span><span class="lang-id">Menu / katalog</span><span class="lang-en">Menu / catalogue</span></span></label>
              <label class="chip"><input type="checkbox" name="need" value="invite" data-id="Undangan" data-en="Invitation"><span><span class="lang-id">Undangan</span><span class="lang-en">Invitation</span></span></label>
              <label class="chip"><input type="checkbox" name="need" value="event" data-id="Backdrop / banner / booth" data-en="Backdrop / banner / booth"><span>Backdrop / banner</span></label>
              <label class="chip"><input type="checkbox" name="need" value="merch" data-id="Kaos / jersey olahraga / merchandise" data-en="T-shirt / sports jersey / merchandise"><span><span class="lang-id">Kaos / jersey</span><span class="lang-en">T-shirt / jersey</span></span></label>
              <label class="chip"><input type="checkbox" name="need" value="logo" data-id="Simple logo" data-en="Simple logo"><span>Simple logo</span></label>
              <label class="chip"><input type="checkbox" name="need" value="email" data-id="Newsletter / email blast" data-en="Newsletter / email blast"><span>Newsletter / email blast</span></label>
              <label class="chip"><input type="checkbox" name="need" value="packaging" data-id="Kemasan / packaging" data-en="Packaging"><span><span class="lang-id">Kemasan</span><span class="lang-en">Packaging</span></span></label>
              <label class="chip"><input type="checkbox" name="need" value="other" data-id="Lainnya" data-en="Something else"><span><span class="lang-id">Lainnya</span><span class="lang-en">Other</span></span></label>
            </div>
            <p class="field-error"><span class="lang-id">Pilih minimal satu.</span><span class="lang-en">Pick at least one.</span></p>
          </fieldset>

          <fieldset class="field">
            <legend><span class="lang-id">Untuk</span><span class="lang-en">For</span></legend>
            <div class="chips">
              <label class="chip"><input type="checkbox" name="use" value="digital" data-id="Digital" data-en="Digital"><span>Digital</span></label>
              <label class="chip"><input type="checkbox" name="use" value="print" data-id="Cetak" data-en="Print"><span><span class="lang-id">Cetak</span><span class="lang-en">Print</span></span></label>
            </div>
          </fieldset>

          <div class="field-row">
            <div class="field">
              <label for="f-count"><span class="lang-id">Jumlah desain</span><span class="lang-en">Number of designs</span></label>
              <select id="f-count" name="count">
                <option value="" data-id="Pilih" data-en="Choose">Pilih</option>
                <option value="1" data-id="1 desain" data-en="1 design">1 desain</option>
                <option value="2-5" data-id="2–5 desain" data-en="2–5 designs">2–5 desain</option>
                <option value="6-10" data-id="6–10 desain" data-en="6–10 designs">6–10 desain</option>
                <option value="10+" data-id="Lebih dari 10" data-en="More than 10">Lebih dari 10</option>
                <option value="unsure" data-id="Belum tahu" data-en="Not sure yet">Belum tahu</option>
              </select>
            </div>
            <div class="field">
              <label for="f-when"><span class="lang-id">Target selesai</span><span class="lang-en">Deadline</span></label>
              <select id="f-when" name="when">
                <option value="" data-id="Pilih" data-en="Choose">Pilih</option>
                <option value="asap" data-id="Secepatnya" data-en="As soon as possible">Secepatnya</option>
                <option value="2w" data-id="Kurang dari 2 minggu" data-en="Within two weeks">Kurang dari 2 minggu</option>
                <option value="1m" data-id="Kurang dari 1 bulan" data-en="Within a month">Kurang dari 1 bulan</option>
                <option value="unsure" data-id="Belum tahu" data-en="Not sure yet">Belum tahu</option>
              </select>
            </div>
          </div>

          <div class="field">
            <label for="f-ref"><span class="lang-id">Referensi desain</span><span class="lang-en">Design reference</span></label>
            <input id="f-ref" name="ref" data-ph-id="Link atau nama akun (opsional)" data-ph-en="A link or an account (optional)">
          </div>

          <div class="field">
            <label for="f-note"><span class="lang-id">Ceritakan kebutuhanmu</span><span class="lang-en">Tell us what you need</span></label>
            <textarea id="f-note" name="note" rows="3" data-ph-id="Untuk apa, ukuran, gaya, materi yang sudah ada, atau apa pun di kepalamu" data-ph-en="What it's for, sizes, style, material you already have, anything on your mind"></textarea>
          </div>

          <button class="btn btn-red btn-lg btn-block" type="submit">
            <svg class="wa-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.3 7.4L3 21l2.1-5.6A8.4 8.4 0 1 1 21 11.5z"/></svg>
            <span class="lang-id">Lanjutkan ke WhatsApp</span><span class="lang-en">Continue on WhatsApp</span>
          </button>
          <p class="brief-note"><span class="lang-id">Pesan terbuka di WhatsApp. Data formulir tidak disimpan.</span><span class="lang-en">Your message opens in WhatsApp. Nothing is stored.</span></p>
        </form>
      </div>
    </section>
  </main>

