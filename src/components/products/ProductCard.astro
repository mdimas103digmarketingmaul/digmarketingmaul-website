---
// Presentation data only. worker.js remains authoritative for payment amounts.
const { product: p, number } = Astro.props;
---
<article class={`commerce-product-card${p.url ? ' js-detail-card' : ''}`}
  aria-label={p.url ? `Lihat detail ${p.name.id}` : undefined}
  data-detail-url={p.url} data-price={p.amount} data-product-id={p.id} data-cat={p.category}
  role={p.url ? 'link' : undefined} tabindex={p.url ? '0' : undefined}>
  <span aria-hidden="true" class="card-sheen"></span>
  <span class="topic-number">{String(number).padStart(2, '0')}</span>
  <div class="commerce-card-top">
    <span class="product-icon"><i class={p.icon}></i></span>
    <span class="commerce-category">{p.categoryLabel}</span>
  </div>
  {p.name.en ? <><h2 data-copy-lang="id">{p.name.id}</h2><h2 data-copy-lang="en" hidden>{p.name.en}</h2></> : <h2>{p.name.id}</h2>}
  <p class="commerce-description" data-copy-lang="id">{p.description.id}</p>
  <p class="commerce-description" data-copy-lang="en" hidden>{p.description.en}</p>
  <div class="commerce-card-footer">
    {p.originalPrice ? <div class="commerce-price-stack">
      <div class="commerce-price" data-price-id={p.price.id} data-price-usd={p.price.usd}>{p.price.id}</div>
      <div class="commerce-original-price" data-price-id={p.originalPrice.id} data-price-usd={p.originalPrice.usd}>{p.originalPrice.id}</div>
    </div> : <div class="commerce-price" data-price-id={p.price.id} data-price-usd={p.price.usd}>{p.price.id}</div>}
    {p.promo.id && <><div class="commerce-promo-note" data-copy-lang="id">{p.promo.id}</div><div class="commerce-promo-note" data-copy-lang="en" hidden>{p.promo.en}</div></>}
    {p.paymentSupport ? <div class="payment-support-row">
      <div class="payment-progress"><span class="payment-progress-dot"></span>Secure Payment Gateway</div>
      <div class="international-payment-support" hidden aria-label="Supported payment methods">
        <svg class="paypal-wordmark" viewBox="0 0 110 34" role="img" aria-label="PayPal"><text x="2" y="25" font-family="Arial, Helvetica, sans-serif" font-weight="700" font-style="italic" font-size="29" letter-spacing="-1.5" fill="#003087">Pay<tspan fill="#0070e0">Pal</tspan></text></svg>
        <img src="/assets/payment-methods/visa.webp" alt="Visa" loading="lazy" />
        <img src="/assets/payment-methods/mastercard.webp" alt="Mastercard" loading="lazy" />
        <img src="/assets/payment-methods/amex.svg" alt="American Express" loading="lazy" />
        <img src="/assets/payment-methods/jcb.webp" alt="JCB" loading="lazy" />
        <img src="/assets/payment-methods/unionpay.svg" alt="UnionPay" loading="lazy" />
      </div>
    </div> : <div class="payment-progress"><span class="payment-progress-dot"></span><span data-copy-lang="id">{p.progress.id}</span><span data-copy-lang="en" hidden>{p.progress.en}</span></div>}
    <div class="payment-status-detail" hidden></div>
    {p.status === 'available' ? <a class="commerce-checkout-btn is-ready" href={p.url} style="text-decoration:none;text-align:center;display:block;"><span data-copy-lang="id">{p.cta.id}</span><span data-copy-lang="en" hidden>{p.cta.en}</span></a> : <button class="commerce-checkout-btn is-coming-soon" disabled type="button"><span data-copy-lang="id">{p.cta.id}</span><span data-copy-lang="en" hidden>{p.cta.en}</span></button>}
  </div>
</article>
