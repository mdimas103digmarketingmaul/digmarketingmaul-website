{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "digmarketingmaul-website",
  "main": "worker.js",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "digmarketingmaul.my.id",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/admin/*",
      "/",
      "/index.html",
      "/*.html",
      "/frameworks",
      "/frameworks/*",
      "/blog",
      "/blog/*",
      "/profile",
      "/profile/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "digmarketingmaul-payments",
      "database_id": "bcf2ab90-f8f9-41e1-b502-96e997cd0236"
    }
  ],
  "keep_vars": true
}
