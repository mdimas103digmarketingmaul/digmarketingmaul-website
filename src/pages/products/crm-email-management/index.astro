    <!-- ============ FAQ ============ -->
    <section class="faq" id="faq" aria-labelledby="faq-title">
      <div class="shell">
        <h2 class="section-title" id="faq-title" data-reveal-title>
          <span class="mask-line"><span>FAQ<span class="accent-dot">.</span></span></span>
        </h2>
        <div class="faq-list">
          {faq.map((item) => (
            <details class="reveal">
              <summary><span class="lang-id" set:html={item.id.q} /><span class="lang-en" set:html={item.en.q} /></summary>
              <div class="faq-a"><p><span class="lang-id" set:html={item.id.a} /><span class="lang-en" set:html={item.en.a} /></p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ CONTACT: brief form → WhatsApp (prefilled) ============ -->
    <section class="contact" id="contact" aria-labelledby="final-title">
      <div class="shell contact-grid">
        <div class="contact-intro">
          <h2 class="section-title" id="final-title" data-reveal-title>
            <span class="mask-line"><span>Let's discuss</span></span>
            <span class="mask-line"><span>your <em>CRM</em><span class="accent-dot">.</span></span></span>
          </h2>
          <p class="contact-lead"><span class="lang-id">Isi singkat, lanjut ke WhatsApp.</span><span class="lang-en">A quick brief, then WhatsApp.</span></p>
          <div class="chat" aria-hidden="true">
            <div class="chat-head">
              <span class="chat-avatar"><img src="/assets/brand/logo/icon.svg" alt="" width="26" height="26"></span>
              <span><strong>Maul</strong><small><span class="lang-id">Pratinjau pesan kamu</span><span class="lang-en">Your message preview</span></small></span>
            </div>
            <div class="chat-body">
              <p class="chat-bubble"><span data-chat-text></span><small><span class="lang-id">Belum terkirim</span><span class="lang-en">Not sent yet</span></small></p>
            </div>
          </div>
        </div>

        <form class="brief" data-brief data-copy={JSON.stringify(briefCopy)} novalidate>
          <div class="brief-head">
            <p class="brief-title"><span class="lang-id">Brief CRM</span><span class="lang-en">CRM brief</span></p>
            <span class="brief-chip"><span class="lang-id">± 1 menit</span><span class="lang-en">± 1 minute</span></span>
          </div>

          <div class="field" data-field="name">
            <label for="f-name"><span class="lang-id">Nama kamu</span><span class="lang-en">Your name</span> <b>*</b></label>
            <input id="f-name" name="name" autocomplete="name" required data-ph-id="Nama panggilan" data-ph-en="What should we call you?">
            <p class="field-error"><span class="lang-id">Isi nama dulu, ya.</span><span class="lang-en">Please add your name.</span></p>
          </div>

          <div class="field">
            <label for="f-brand"><span class="lang-id">Bisnis / brand</span><span class="lang-en">Business / brand</span></label>
            <input id="f-brand" name="brand" autocomplete="organization" data-ph-id="Contoh: Kopi Senja" data-ph-en="e.g. Senja Coffee">
          </div>

          <fieldset class="field" data-field="need">
            <legend><span class="lang-id">Kamu butuh</span><span class="lang-en">You need</span> <b>*</b> <small class="legend-hint"><span class="lang-id">boleh lebih dari satu</span><span class="lang-en">pick any</span></small></legend>
            <div class="chips">
              <label class="chip"><input type="checkbox" name="need" value="setup" data-id="Setup & integrasi" data-en="Setup & integration"><span><span class="lang-id">Setup &amp; integrasi</span><span class="lang-en">Setup &amp; integration</span></span></label>
              <label class="chip"><input type="checkbox" name="need" value="blast" data-id="Email blast / newsletter" data-en="Email blast / newsletter"><span>Email blast</span></label>
              <label class="chip"><input type="checkbox" name="need" value="message" data-id="Message blast" data-en="Message blast"><span>Message blast</span></label>
              <label class="chip"><input type="checkbox" name="need" value="automation" data-id="Automation & trigger" data-en="Automation & triggers"><span>Automation</span></label>
              <label class="chip"><input type="checkbox" name="need" value="segment" data-id="Segmentasi & data" data-en="Segmentation & data"><span><span class="lang-id">Segmentasi &amp; data</span><span class="lang-en">Segments &amp; data</span></span></label>
              <label class="chip"><input type="checkbox" name="need" value="content" data-id="Desain & copywriting" data-en="Design & copywriting"><span><span class="lang-id">Desain &amp; copy</span><span class="lang-en">Design &amp; copy</span></span></label>
              <label class="chip"><input type="checkbox" name="need" value="report" data-id="Evaluasi & report" data-en="Evaluation & reports"><span><span class="lang-id">Evaluasi &amp; report</span><span class="lang-en">Evaluation &amp; reports</span></span></label>
              <label class="chip"><input type="checkbox" name="need" value="audit" data-id="Audit akun & langganan" data-en="Account & plan audit"><span><span class="lang-id">Audit langganan</span><span class="lang-en">Plan audit</span></span></label>
              <label class="chip"><input type="checkbox" name="need" value="other" data-id="Lainnya" data-en="Something else"><span><span class="lang-id">Lainnya</span><span class="lang-en">Other</span></span></label>
            </div>
            <p class="field-error"><span class="lang-id">Pilih minimal satu.</span><span class="lang-en">Pick at least one.</span></p>
          </fieldset>

          <fieldset class="field">
            <legend><span class="lang-id">Platform sekarang</span><span class="lang-en">Current platform</span></legend>
            <div class="chips">
              <label class="chip"><input type="checkbox" name="use" value="mailchimp" data-id="Mailchimp" data-en="Mailchimp"><span>Mailchimp</span></label>
              <label class="chip"><input type="checkbox" name="use" value="resend" data-id="Resend" data-en="Resend"><span>Resend</span></label>
              <label class="chip"><input type="checkbox" name="use" value="insider" data-id="Insider One" data-en="Insider One"><span>Insider One</span></label>
              <label class="chip"><input type="checkbox" name="use" value="other" data-id="Platform lain" data-en="Another platform"><span><span class="lang-id">Lainnya</span><span class="lang-en">Other</span></span></label>
              <label class="chip"><input type="checkbox" name="use" value="none" data-id="Belum ada" data-en="None yet"><span><span class="lang-id">Belum ada</span><span class="lang-en">None yet</span></span></label>
            </div>
          </fieldset>

          <div class="field-row">
            <div class="field">
              <label for="f-count"><span class="lang-id">Jumlah kontak</span><span class="lang-en">Contacts</span></label>
              <select id="f-count" name="count">
                <option value="" data-id="Pilih" data-en="Choose">Pilih</option>
                <option value="small" data-id="Di bawah 2.000" data-en="Under 2,000">Di bawah 2.000</option>
                <option value="mid" data-id="2.000 – 50.000" data-en="2,000 – 50,000">2.000 – 50.000</option>
                <option value="large" data-id="Di atas 50.000" data-en="Over 50,000">Di atas 50.000</option>
                <option value="unsure" data-id="Belum tahu" data-en="Not sure yet">Belum tahu</option>
              </select>
            </div>
            <div class="field">
              <label for="f-when"><span class="lang-id">Target mulai</span><span class="lang-en">Start date</span></label>
              <select id="f-when" name="when">
                <option value="" data-id="Pilih" data-en="Choose">Pilih</option>
                <option value="asap" data-id="Secepatnya" data-en="As soon as possible">Secepatnya</option>
                <option value="1m" data-id="Kurang dari 1 bulan" data-en="Within a month">Kurang dari 1 bulan</option>
                <option value="3m" data-id="1–3 bulan" data-en="1–3 months">1–3 bulan</option>
                <option value="unsure" data-id="Belum tahu" data-en="Not sure yet">Belum tahu</option>
              </select>
            </div>
          </div>

          <div class="field">
            <label for="f-ref">Website</label>
            <input id="f-ref" name="ref" data-ph-id="Link website (opsional)" data-ph-en="Website link (optional)">
          </div>

          <div class="field">
            <label for="f-note"><span class="lang-id">Ceritakan kebutuhanmu</span><span class="lang-en">Tell us what you need</span></label>
            <textarea id="f-note" name="note" rows="3" data-ph-id="Tujuan, kondisi akun sekarang, kendala, atau apa pun di kepalamu" data-ph-en="Your goal, the account today, problems, anything on your mind"></textarea>
          </div>

          <button class="btn btn-red btn-lg btn-block" type="submit">
            <svg class="wa-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.3 7.4L3 21l2.1-5.6A8.4 8.4 0 1 1 21 11.5z"/></svg>
            <span class="lang-id">Lanjutkan ke WhatsApp</span><span class="lang-en">Continue on WhatsApp</span>
          </button>
          <p class="brief-note"><span class="lang-id">Pesan terbuka di WhatsApp. Data formulir tidak disimpan.</span><span class="lang-en">Your message opens in WhatsApp. Nothing is stored.</span></p>
        </form>
      </div>
    </section>
  </main>

