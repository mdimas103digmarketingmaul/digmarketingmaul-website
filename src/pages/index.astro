              <span class="visually-hidden">Collaborate</span>
              <span class="collab-letters" aria-hidden="true"><span class="collab-letter" style="--i:0">C</span><span class="collab-letter" style="--i:1">o</span><span class="collab-letter" style="--i:2">l</span><span class="collab-letter" style="--i:3">l</span><span class="collab-letter" style="--i:4">a</span><span class="collab-letter" style="--i:5">b</span><span class="collab-letter" style="--i:6">o</span><span class="collab-letter" style="--i:7">r</span><span class="collab-letter" style="--i:8">a</span><span class="collab-letter" style="--i:9">t</span><span class="collab-letter" style="--i:10">e</span></span>
            </h2>
            <span class="collab-button" data-magnetic>
              <svg class="collab-ring" viewBox="0 0 200 200" aria-hidden="true">
                <defs><path id="collab-circle" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"/></defs>
                <text><textPath href="#collab-circle">See products &amp; services • See products &amp; services • </textPath></text>
              </svg>
              <span class="collab-arrow"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
              <span class="visually-hidden">— see products and services</span>
            </span>
            <!-- phones: replaces the spinning ring -->
            <span class="collab-mobile-cta">See products &amp; services <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
          </a>
        </div>
      </div>
    </section>

    <!-- =========================================================
