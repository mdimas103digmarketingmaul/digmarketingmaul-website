    <!-- ============ FAQ ============ -->
    <section class="faq" id="faq" aria-labelledby="faq-title">
      <div class="shell">
        <h2 class="section-title" id="faq-title" data-reveal-title>
          <span class="mask-line"><span>FAQ<span class="accent-dot">.</span></span></span>
        </h2>
        <div class="faq-list">
          {faq.map((item) => (
            <details class="reveal">
              <summary><span class="lang-id" set:html={item.id.q} /><span class="lang-en" set:html={item.en.q} /></summary>
              <div class="faq-a">
                {item.id.a.map((answer, i) => <p><span class="lang-id" set:html={answer} /><span class="lang-en" set:html={item.en.a[i]} /></p>)}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ CONTACT — booking form → WhatsApp (prefilled) ============ -->
    <section class="contact" id="contact" aria-labelledby="final-title">
      <div class="shell contact-grid">
        <div class="contact-intro">
          <h2 class="section-title" id="final-title" data-reveal-title>
            <span class="mask-line"><span>Let's talk,</span></span>
            <span class="mask-line"><span><em>1 on 1</em><span class="accent-dot">.</span></span></span>
          </h2>
          <p class="contact-lead"><span class="lang-id">Ceritakan topiknya, kita janjian di WhatsApp.</span><span class="lang-en">Tell me the topic, we'll set a time on WhatsApp.</span></p>

          <div class="chat" aria-hidden="true">
            <div class="chat-head">
              <span class="chat-avatar"><img src="/assets/brand/logo/icon.svg" alt="" width="26" height="26"></span>
              <span><strong>Maul</strong><small><span class="lang-id">Pratinjau pesan kamu</span><span class="lang-en">Your message preview</span></small></span>
            </div>
            <div class="chat-body">
              <p class="chat-bubble"><span data-chat-text></span><small><span class="lang-id">Belum terkirim</span><span class="lang-en">Not sent yet</span></small></p>
            </div>
          </div>
        </div>

        <form class="brief" data-brief data-price-id={PRICE.id} data-price-usd={PRICE.usd} novalidate>
          <div class="brief-head">
            <p class="brief-title"><span class="lang-id">Ajak ngobrol</span><span class="lang-en">Start a conversation</span></p>
            <span class="brief-chip"><span class="lang-id">± 1 menit</span><span class="lang-en">± 1 minute</span></span>
          </div>

          <div class="field" data-field="name">
            <label for="f-name"><span class="lang-id">Nama kamu</span><span class="lang-en">Your name</span> <b>*</b></label>
            <input id="f-name" name="name" autocomplete="name" required data-ph-id="Nama panggilan" data-ph-en="What should I call you?">
            <p class="field-error"><span class="lang-id">Isi nama dulu, ya.</span><span class="lang-en">Please add your name.</span></p>
          </div>

          <div class="field">
            <label for="f-brand"><span class="lang-id">Bisnis / pekerjaan</span><span class="lang-en">Business / role</span></label>
            <input id="f-brand" name="brand" autocomplete="organization" data-ph-id="Contoh: Kopi Senja, atau marketer di agensi" data-ph-en="e.g. Senja Coffee, or a marketer at an agency">
          </div>

          <fieldset class="field" data-field="need">
            <legend><span class="lang-id">Mau bahas</span><span class="lang-en">I'd like to talk about</span> <b>*</b> <small class="legend-hint"><span class="lang-id">boleh lebih dari satu</span><span class="lang-en">pick any</span></small></legend>
            <div class="chips">
              <label class="chip"><input type="checkbox" name="need" value="website" data-id="Website" data-en="Website"><span>Website</span></label>
              <label class="chip"><input type="checkbox" name="need" value="motion" data-id="Video &amp; motion" data-en="Video &amp; motion"><span>Video &amp; motion</span></label>
              <label class="chip"><input type="checkbox" name="need" value="ai" data-id="AI &amp; automation" data-en="AI &amp; automation"><span>AI &amp; automation</span></label>
              <label class="chip"><input type="checkbox" name="need" value="reporting" data-id="Reporting &amp; data" data-en="Reporting &amp; data"><span>Reporting &amp; data</span></label>
              <label class="chip"><input type="checkbox" name="need" value="ads" data-id="Digital ads &amp; tracking" data-en="Digital ads &amp; tracking"><span>Digital ads &amp; tracking</span></label>
              <label class="chip"><input type="checkbox" name="need" value="other" data-id="Lainnya" data-en="Something else"><span><span class="lang-id">Lainnya</span><span class="lang-en">Other</span></span></label>
            </div>
            <p class="field-error"><span class="lang-id">Pilih minimal satu.</span><span class="lang-en">Pick at least one.</span></p>
          </fieldset>

          <div class="field-row">
            <div class="field">
              <label for="f-level"><span class="lang-id">Posisi kamu sekarang</span><span class="lang-en">Where you are now</span></label>
              <select id="f-level" name="level">
                <option value="" data-id="Pilih" data-en="Choose">Pilih</option>
                <option value="new" data-id="Baru mulai" data-en="Just starting">Baru mulai</option>
                <option value="running" data-id="Sudah jalan, mau naik level" data-en="Running, want to level up">Sudah jalan, mau naik level</option>
                <option value="pro" data-id="Profesional, ingin bertukar pengalaman" data-en="Professional, want to swap notes">Profesional, ingin bertukar pengalaman</option>
              </select>
            </div>
            <div class="field">
              <label for="f-when"><span class="lang-id">Waktu yang cocok</span><span class="lang-en">Best time</span></label>
              <select id="f-when" name="when">
                <option value="" data-id="Pilih" data-en="Choose">Pilih</option>
                <option value="weekday-day" data-id="Hari kerja, siang" data-en="Weekday, daytime">Hari kerja, siang</option>
                <option value="weekday-night" data-id="Hari kerja, malam" data-en="Weekday, evening">Hari kerja, malam</option>
                <option value="weekend" data-id="Akhir pekan" data-en="Weekend">Akhir pekan</option>
                <option value="flexible" data-id="Fleksibel" data-en="Flexible">Fleksibel</option>
              </select>
            </div>
          </div>

          <fieldset class="field">
            <legend><span class="lang-id">Lebih nyaman lewat</span><span class="lang-en">I'd prefer</span></legend>
            <div class="chips">
              <label class="chip"><input type="radio" name="format" value="call" data-id="Video call" data-en="Video call"><span>Video call</span></label>
              <label class="chip"><input type="radio" name="format" value="chat" data-id="Chat WhatsApp" data-en="WhatsApp chat"><span><span class="lang-id">Chat WhatsApp</span><span class="lang-en">WhatsApp chat</span></span></label>
              <label class="chip"><input type="radio" name="format" value="any" data-id="Yang mana saja" data-en="Either is fine"><span><span class="lang-id">Yang mana saja</span><span class="lang-en">Either</span></span></label>
            </div>
          </fieldset>

          <div class="field">
            <label for="f-note"><span class="lang-id">Pertanyaan utama kamu</span><span class="lang-en">Your main question</span></label>
            <textarea id="f-note" name="note" rows="3" data-ph-id="Contoh: ingin tahu cara bikin report mingguan yang otomatis" data-ph-en="e.g. how to make a weekly report that builds itself"></textarea>
          </div>

          <button class="btn btn-red btn-lg btn-block" type="submit">
            <svg class="wa-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.3 7.4L3 21l2.1-5.6A8.4 8.4 0 1 1 21 11.5z"/></svg>
            <span class="lang-id">Lanjutkan ke WhatsApp</span><span class="lang-en">Continue on WhatsApp</span>
          </button>
          <p class="brief-note"><span class="lang-id">Pesan terbuka di WhatsApp. Data formulir tidak disimpan.</span><span class="lang-en">Your message opens in WhatsApp. Nothing is stored.</span></p>
        </form>
      </div>
    </section>
  </main>

