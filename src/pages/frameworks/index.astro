---
import navigationCss from '../../styles/site/navigation-responsive.css?url';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandFooter from '../../components/site/BrandFooter.astro';
import SiteHeader from '../../components/site/SiteHeader.astro';
import sharedCss from '../../styles/site/shared.css?url';
import familyCss from '../../styles/frameworks/listing.css?url';
import sharedJs from '../../scripts/site/interactions.js?url';
const meta = {
  "title": "Frameworks — M. Dimas Maulana",
  "description": "Digital marketing frameworks and systems by M. Dimas Maulana — how I think, build, optimize, and automate.",
  "themeColor": "#07111f",
  "canonical": "/frameworks/"
};
---
<BaseLayout meta={meta} lang="en" htmlAttributes={{}} bodyAttributes={{"data-page": "frameworks"}}>
<Fragment slot="head">
<link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
  <link rel="stylesheet" href={sharedCss} />
<link rel="stylesheet" href={familyCss} />
<link rel="stylesheet" href={navigationCss} />
</Fragment>
<div class="aurora-layer" aria-hidden="true">
    <span class="aurora-orb aurora-one"></span>
    <span class="aurora-orb aurora-two"></span>
    <span class="aurora-orb aurora-three"></span>
  </div>

  <div class="grid-layer" aria-hidden="true"></div>
  <div class="cursor-grid-light" id="cursor-grid-light" aria-hidden="true"></div>
  <div class="grain-layer" aria-hidden="true"></div>

  <aside class="social-rail social-rail-left" aria-label="Social media links">
    <div class="social-rail-links">
      <a href="https://www.instagram.com/dig.marketing.maul/" class="social-link" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
      <a href="https://www.linkedin.com/in/muhammad-dimas-maulana-4a5526148/" class="social-link" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
      <a href="https://www.tiktok.com/@digmarketingmaul" class="social-link" target="_blank" rel="noopener noreferrer" aria-label="TikTok"><i class="fa-brands fa-tiktok"></i></a>
    </div>
    <span class="social-rail-line" aria-hidden="true"></span>
  </aside>

  <aside class="social-rail social-rail-right" aria-label="Email">
    <a href="mailto:mdimas103@gmail.com" class="email-rail-link">mdimas103@gmail.com</a>
    <span class="social-rail-line" aria-hidden="true"></span>
  </aside>

  <SiteHeader active="frameworks" />


  <main>

    <section class="subpage-hero framework-hero">
      <div class="subpage-hero-inner">

        <div class="subpage-kicker reveal-item">
          <span class="kicker-line"></span>
          <span>Frameworks / Systems</span>
        </div>

        <div class="reveal-mask">
          <h1 class="subpage-title framework-page-title hero-title-gradient reveal-item reveal-delay-1">
            How I Think, Build,<br>
            <span class="accent-text">Optimize &amp; Automate.</span>
          </h1>
        </div>

        <div class="subpage-intro framework-intro reveal-item reveal-delay-2">
          <p>
            These frameworks document the systems behind how I think, build,
            manage, test, and automate digital marketing.
          </p>

          <p>
            They reflect the processes I use to turn ideas, data, and experiments
            into structured and repeatable ways of working.
          </p>
        </div>

        <div class="subpage-orbit" aria-hidden="true">
          <span class="subpage-orbit-ring ring-a"></span>
          <span class="subpage-orbit-ring ring-b"></span>
          <span class="subpage-orbit-dot"></span>
        </div>

      </div>
    </section>

    <section class="framework-section section-reveal">

      <div class="framework-library-heading">
        <div class="subpage-kicker">
          <span class="kicker-line"></span>
          <span>System Library</span>
        </div>
      </div>

      <div class="framework-list">

        <a class="framework-card framework-card-link" href="/frameworks/digital-ads-operating-system/">
          <span class="card-sheen" aria-hidden="true"></span>

          <div class="framework-card-index">
            <span class="framework-number">01</span>
            <span class="framework-icon"><i class="fa-solid fa-chart-column"></i></span>
          </div>

          <div class="framework-card-content">
            <p class="framework-label">Digital Advertising</p>
            <h3>Digital Ads Operating System</h3>
            <p class="framework-description"><em>How I Run &amp; Manage Digital Ads</em></p>
          </div>

          <div class="framework-status framework-read">
            Read Framework <i class="fa-solid fa-arrow-right"></i>
          </div>
        </a>

        <article class="framework-card">
          <span class="card-sheen" aria-hidden="true"></span>

          <div class="framework-card-index">
            <span class="framework-number">02</span>
            <span class="framework-icon"><i class="fa-solid fa-gears"></i></span>
          </div>

          <div class="framework-card-content">
            <p class="framework-label">Automation &amp; Analysis</p>
            <h3>Automated Marketing Performance Review System</h3>
            <p class="framework-description">
              <em>How I Monitor, Review &amp; Analyze Digital Marketing Performance Daily / Weekly / Monthly</em>
            </p>
          </div>

          <div class="framework-status">Automation System</div>
        </article>

        <article class="framework-card">
          <span class="card-sheen" aria-hidden="true"></span>

          <div class="framework-card-index">
            <span class="framework-number">03</span>
            <span class="framework-icon"><i class="fa-solid fa-pen-ruler"></i></span>
          </div>

          <div class="framework-card-content">
            <p class="framework-label">Creative &amp; Branding</p>
            <h3>Creative Production for Digital Branding</h3>

            <div class="framework-flow" aria-label="Creative production workflow">
              <span>Brief</span><i class="fa-solid fa-arrow-right"></i>
              <span>Produce</span><i class="fa-solid fa-arrow-right"></i>
              <span>Launch</span><i class="fa-solid fa-arrow-right"></i>
              <span>Test</span><i class="fa-solid fa-arrow-right"></i>
              <span>Analyze</span><i class="fa-solid fa-arrow-right"></i>
              <span>Iterate</span>
            </div>
          </div>

          <div class="framework-status">Workflow</div>
        </article>

        <article class="framework-card">
          <span class="card-sheen" aria-hidden="true"></span>

          <div class="framework-card-index">
            <span class="framework-number">04</span>
            <span class="framework-icon"><i class="fa-solid fa-code"></i></span>
          </div>

          <div class="framework-card-content">
            <p class="framework-label">Web &amp; Build</p>
            <h3>Website Launch System with Vibe Coding</h3>

            <div class="framework-flow" aria-label="Website launch workflow">
              <span>Idea</span><i class="fa-solid fa-arrow-right"></i>
              <span>Planning</span><i class="fa-solid fa-arrow-right"></i>
              <span>Build</span><i class="fa-solid fa-arrow-right"></i>
              <span>Measurement</span><i class="fa-solid fa-arrow-right"></i>
              <span>Testing</span><i class="fa-solid fa-arrow-right"></i>
              <span>Launch</span>
            </div>
          </div>

          <div class="framework-status">Launch System</div>
        </article>

      </div>

      <div class="coming-note framework-note">
        <span class="coming-dot" aria-hidden="true"></span>
        <span>These systems will continue to evolve as I test, learn, and improve how I work.</span>
      </div>

    </section>

    <BrandFooter />

  </main>

  <script is:inline src={sharedJs}></script>
</BaseLayout>
